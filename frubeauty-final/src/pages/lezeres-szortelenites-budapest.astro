<style is:global>
  /* ── „Kizárólag női vendégek” — körbefutó fénynyaláb ──────────────────────
     Ez a chip a hero egyetlen olyan állítása, amit a látogatónak MINDENKÉPP
     észre kell vennie (a visszamondás rosszabb élmény, mint az előre közölt
     nem), viszont nem lehet harsány, mert nem eladási üzenet. A mozgó fény
     pont ezt oldja meg: vonzza a szemet, de nem kiabál.

     TISZTÁN CSS, nulla JS — a hero kritikus útján nem futhat script.

     A mechanizmus: egy ::before pszeudoelem kúp-színátmenettel, `mask`-kal
     gyűrűvé vágva (a két maszk kivonása üresen hagyja a belsőt, így a chip
     átlátszó marad a hero fényudvara fölött). A kúp szögét egy @property-vel
     regisztrált egyéni tulajdonság animálja — enélkül a gradiens szöge nem
     animálható. Ahol a @property nem támogatott, a nyaláb egyszerűen állva
     marad egy arany ívként: a chip akkor sem sérül.

     A `drop-shadow` SZÁNDÉKOSAN a maszkolás után hat, ezért a fénylő
     szakaszt követi — ettől lesz „nyaláb”, nem csak egy vékony vonal. */
  @property --fb-beam-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  @keyframes fbBeamRun {
    to {
      --fb-beam-angle: 360deg;
    }
  }

  .fb-beam {
    position: relative;
    isolation: isolate;
  }

  .fb-beam::before {
    content: '';
    position: absolute;
    /* -1px: a meglévő 1px-es keret FÖLÉ ül, nem alá. */
    inset: -1px;
    border-radius: 999px;
    padding: 2px;
    background: conic-gradient(
      from var(--fb-beam-angle),
      rgba(217, 178, 125, 0) 0deg,
      rgba(217, 178, 125, 0) 160deg,
      rgba(184, 136, 74, 0.5) 246deg,
      #fff2dc 296deg,
      #fff2dc 308deg,
      rgba(217, 178, 125, 0.55) 338deg,
      rgba(217, 178, 125, 0) 360deg
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    filter: drop-shadow(0 0 7px rgba(233, 199, 148, 0.95));
    animation: fbBeamRun 3s linear infinite;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .fb-beam::before {
      animation: none;
    }
  }
</style>

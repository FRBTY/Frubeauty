---
/**
 * /blog/[slug] — individual blog post page.
 *
 * Renders the Markdown body through Astro's content collection render() API,
 * with full article schema, OG image inheritance, prev/next navigation and a
 * related-posts strip (same category).
 *
 * Typography is locked in via the `.prose-frubeauty` class — see <style> block.
 * Dropping into Tailwind Typography plugin was tempting but would have pulled
 * in a stylesheet bigger than the page itself; the handcrafted scope is ~80 lines.
 */
import { getCollection, render } from 'astro:content';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteContact from '../../components/SiteContact.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ArticleOffer from '../../components/ArticleOffer.astro';
import StickyBookBar from '../../components/StickyBookBar.astro';
import { OFFERS } from '../../config/offers';
import RevealCss from '../../components/RevealCss.astro';
import { CookieBanner } from '../../components/CookieBanner';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.data.slug ?? post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

// ── LCP: a borító a mobil LCP-elem (Lighthouse, 2026-10-19). A kisebb változatokat
// a scripts/blog-cover-variants.mjs készíti; csak a ténylegesen létező fájl kerül a
// srcset-be, így egy új cikk a szkript lefuttatása nélkül is hibátlanul renderel.
// A sizes a borító-konténer valódi szélessége (max-w 700, px-5 / sm:px-8 / lg:px-12).
const COVER_WIDTHS = [640, 1000];
const coverSrcset = post.data.cover.endsWith('.webp')
  ? [
      ...COVER_WIDTHS.map((w) => ({ w, src: post.data.cover.replace(/\.webp$/, `-${w}w.webp`) }))
        // A build a projektgyökérből fut; az import.meta.url itt a lefordított chunkra mutatna.
        .filter(({ src }) => existsSync(join(process.cwd(), 'public', src))),
      ...(post.data.coverWidth ? [{ w: post.data.coverWidth, src: post.data.cover }] : []),
    ]
      .map(({ w, src }) => `${src} ${w}w`)
      .join(', ')
  : '';
const coverSizes = '(min-width: 1024px) 604px, (min-width: 640px) 636px, calc(100vw - 40px)';

const dateFormatter = new Intl.DateTimeFormat('hu-HU', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Related posts: same category, exclude current, max 2
const related = allPosts
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 2);

// Sort all posts by date desc for prev/next
const sorted = [...allPosts].sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const currentIdx = sorted.findIndex((p) => p.id === post.id);
const prev = currentIdx > 0 ? sorted[currentIdx - 1] : null;
const next = currentIdx < sorted.length - 1 ? sorted[currentIdx + 1] : null;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  image: `https://frubeauty.com${post.data.cover}`,
  datePublished: post.data.publishedAt.toISOString(),
  ...(post.data.updatedAt && { dateModified: post.data.updatedAt.toISOString() }),
  author: { '@id': 'https://frubeauty.com/#fruzsina' },
  publisher: { '@id': 'https://frubeauty.com/#business' },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://frubeauty.com/blog/${post.data.slug ?? post.id}/`,
  },
};

// ── SEO: BreadcrumbList — Főoldal › Blog › cikk ───────────────────────────────
const postUrl = `https://frubeauty.com/blog/${post.data.slug ?? post.id}/`;
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Főoldal', item: 'https://frubeauty.com' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://frubeauty.com/blog/' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: postUrl },
  ],
};

// ── SEO: FAQPage — a cikk „Gyakori kérdések" szekciójából AUTOMATIKUSAN kinyerve.
// Nincs frontmatter-duplikáció: a törzs egységes `**Kérdés?**` + válasz-bekezdés
// formátumát parse-oljuk, így minden új cikk is megkapja a schemát, ha van
// GYIK-szekciója. A markdown-jelölőket (link, félkövér) sima szöveggé tisztítjuk.
function stripInlineMd(s: string): string {
  return s
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1') // [szöveg](url) → szöveg
    .replace(/\*\*([^*]+)\*\*/g, '$1')        // **félkövér** → félkövér
    .replace(/[*_`]/g, '')                       // maradék hangsúly-jelek
    .replace(/\s+/g, ' ')
    .trim();
}
function extractFaq(body: string | undefined): { q: string; a: string }[] {
  if (!body) return [];
  // A GYIK-szekció a fejléctől a következő H2-ig (vagy a törzs végéig). NINCS /m
  // flag, hogy a `$` a teljes string végét jelentse; a `\n##\s` lookahead csak
  // valódi H2-re áll meg (H3-ra nem).
  const section = body.match(
    /\n##\s+(?:Gyakori kérdések|GYIK|Kérdések)[^\n]*\n([\s\S]*?)(?=\n##\s|$)/,
  );
  if (!section) return [];
  const pairs: { q: string; a: string }[] = [];
  // Két forrásformátum, ugyanaz, mint az astro.config.mjs rehypeFaqAccordion-jében:
  // `**Kérdés?**` + válasz-bekezdés, illetve `### Kérdés?` + a következő bekezdés
  // (a lézer-árcikk így íródott, ezért eddig nem kapott FAQPage-schemát).
  const patterns = [
    /\*\*(.+?\?)\*\*\s*\n+([\s\S]*?)(?=\n\s*\n|\n\*\*|$)/g,
    /^###\s+(.+?\?)\s*\n+([^\n#][^\n]*)/gm,
  ];
  for (const re of patterns) {
    let m: RegExpExecArray | null;
    while ((m = re.exec(section[1])) !== null) {
      const q = stripInlineMd(m[1]);
      const a = stripInlineMd(m[2]);
      if (q && a) pairs.push({ q, a });
    }
  }
  return pairs;
}
const faqPairs = extractFaq(post.body);
const faqSchema =
  faqPairs.length >= 2
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqPairs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
---

<Layout
  title={post.data.metaTitle ?? `${post.data.title} | FRUBEAUTY Blog`}
  description={post.data.metaDescription ?? post.data.excerpt}
  image={post.data.cover}
  imageAlt={post.data.coverAlt}
  preloadImage={post.data.cover}
  preloadImageSrcset={coverSrcset || undefined}
  preloadImageSizes={coverSrcset ? coverSizes : undefined}
  canonical={`https://frubeauty.com/blog/${post.data.slug ?? post.id}/`}
  ogType="article"
  publishedTime={post.data.publishedAt.toISOString()}
  modifiedTime={(post.data.updatedAt ?? post.data.publishedAt).toISOString()}
>
  <SiteHeader />

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

  {/* ============ COVER + META ============ */}
  <article class="pt-[calc(var(--header-h)+1.5rem)] sm:pt-[calc(var(--header-h)+6rem)]">
    <header class="max-w-[920px] mx-auto px-5 sm:px-8 lg:px-12">
      {/* 2026-10-19: a fejléc és a borító STATIKUS (.hero-reveal, csak transform),
          nem <Reveal client:load>. A React-sziget átlátszóról indult, és a
          borító — a mobil LCP-elem — csak hidratálás után festődött: lokálisan
          2,4–6,6 mp Render Delay. Ugyanaz a minta, mint a szolgáltatás-oldalak
          hero-jában (lásd Layout.astro, .hero-reveal). */}
      <div class="hero-reveal">
        {/* flex-wrap: a „Frissítve" dátummal négy elem kerül a sorba, ami 375 px-en
            túlcsordult (nowrap mellett 352 > 335 px). Tördeléssel tisztán tör. */}
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] uppercase tracking-caps text-creamMute mb-6">
          <span class="text-gold">{post.data.category}</span>
          <span aria-hidden>·</span>
          <span>{post.data.readingMinutes} perc olvasás</span>
          <span aria-hidden>·</span>
          <time itemprop="datePublished" datetime={post.data.publishedAt.toISOString()}>
            {dateFormatter.format(post.data.publishedAt)}
          </time>
          {/* SEO: a frissítés dátuma LÁTHATÓAN is kell. A BlogPosting sémában a
              `dateModified` eddig is benne volt, a Google mégis a publikálás
              dátumát mutatta a SERP-ben (élő ellenőrzés: „2026. máj. 12." egy
              07-26-án frissített cikknél) — a látható dátumot részesíti előnyben.
              Örökzöld, „meddig tart / mennyibe kerül" típusú cikkeknél a frissebb
              dátum a találatban mérhető CTR-tényező. */}
          {post.data.updatedAt
            && post.data.updatedAt.getTime() !== post.data.publishedAt.getTime() && (
            <>
              <span aria-hidden>·</span>
              <span>
                Frissítve:{' '}
                <time itemprop="dateModified" datetime={post.data.updatedAt.toISOString()}>
                  {dateFormatter.format(post.data.updatedAt)}
                </time>
              </span>
            </>
          )}
        </div>
        <h1
          class="font-display font-light text-cream leading-[1.06] tracking-tightest-"
          style="font-size: clamp(2rem, 5vw, 3.5rem);"
        >
          {post.data.title}
        </h1>
        <p class="mt-6 text-base sm:text-lg text-creamSoft leading-[1.7] max-w-[60ch]">
          {post.data.excerpt}
        </p>
        <address class="author byline mt-7 flex items-center gap-3 not-italic" itemprop="author" itemscope itemtype="https://schema.org/Person">
          <span class="w-10 h-10 rounded-full bg-gold/15 text-gold flex items-center justify-center text-sm font-medium" aria-hidden>FP</span>
          <p class="text-sm text-creamSoft">
            Írta: <a href="/rolam/" rel="author" itemprop="name" class="text-cream font-medium hover:text-gold transition-colors">Pecze-Kovács Fruzsina</a>
            <span class="text-creamMute" itemprop="jobTitle"> — kozmetikus &amp; sminkes, Zugló</span>
          </p>
        </address>
      </div>
    </header>

    <div class="hero-reveal max-w-[700px] mx-auto px-5 sm:px-8 lg:px-12 mt-12 sm:mt-16">
      <div class="rounded-3xl bg-inkRise ring-1 ring-black">
        <img
          src={post.data.cover}
          srcset={coverSrcset || undefined}
          sizes={coverSrcset ? coverSizes : undefined}
          alt={post.data.coverAlt}
          width={post.data.coverWidth}
          height={post.data.coverHeight}
          class="w-full h-auto object-contain"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>

    {/* ============ BODY ============ */}
    <div class="max-w-[900px] mx-auto px-5 sm:px-8 lg:px-12 py-16 sm:py-24">
      {/* A cikk témájához tartozó szolgáltatás + ár, mielőtt olvasni kezd.
          A mért probléma: a blogról érkező organikus látogatók 12%-a jut el a
          foglalásig, a szolgáltatás-oldalakról 80% (GA4, 2026-08). */}
      <ArticleOffer category={post.data.category} variant="slim" />
      <div class="prose-frubeauty">
        <Content />
      </div>
      <ArticleOffer category={post.data.category} />
    </div>
  </article>

  {/* ============ PREV / NEXT ============ */}
  {(prev || next) && (
    <section class="pb-16 sm:pb-24 border-t border-whisper">
      <div class="max-w-[1100px] mx-auto px-5 sm:px-8 lg:px-12 pt-12 sm:pt-16">
        <RevealCss as="nav" class="grid sm:grid-cols-2 gap-6 sm:gap-8" aria-label="Cikkek navigáció">
          {prev ? (
            <a
              href={`/blog/${prev.data.slug ?? prev.id}/`}
              class="group flex flex-col bg-inkSoft border border-whisper rounded-3xl p-6 sm:p-7 md:hover:border-whisperStrong transition-colors duration-500"
            >
              <span class="text-[11px] uppercase tracking-caps text-creamMute mb-3">← Előző cikk</span>
              <span class="font-display text-lg sm:text-xl font-medium text-cream group-hover:text-gold transition-colors duration-300 leading-snug">
                {prev.data.title}
              </span>
            </a>
          ) : <div aria-hidden></div>}
          {next ? (
            <a
              href={`/blog/${next.data.slug ?? next.id}/`}
              class="group flex flex-col sm:items-end sm:text-right bg-inkSoft border border-whisper rounded-3xl p-6 sm:p-7 md:hover:border-whisperStrong transition-colors duration-500"
            >
              <span class="text-[11px] uppercase tracking-caps text-creamMute mb-3">Következő cikk →</span>
              <span class="font-display text-lg sm:text-xl font-medium text-cream group-hover:text-gold transition-colors duration-300 leading-snug">
                {next.data.title}
              </span>
            </a>
          ) : <div aria-hidden></div>}
        </RevealCss>
      </div>
    </section>
  )}

  {/* ============ RELATED ============ */}
  {related.length > 0 && (
    <section class="py-20 sm:py-28 bg-inkSoft">
      <div class="max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12">
        <RevealCss class="mb-10 sm:mb-12 flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="text-[11px] uppercase tracking-caps text-gold mb-4">Hasonló cikkek</p>
            <h2
              class="font-display font-light leading-[1.1] tracking-tight text-cream"
              style="font-size: clamp(1.5rem, 3vw, 2rem);"
            >
              További olvasnivaló a kategóriából.
            </h2>
          </div>
          <a href="/blog/" class="text-[12px] uppercase tracking-caps text-creamMute hover:text-cream transition-colors">
            Összes cikk →
          </a>
        </RevealCss>
        <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
          {related.map((p) => (
            <RevealCss as="article">
              <a
                href={`/blog/${p.data.slug ?? p.id}/`}
                class="group flex flex-col h-full bg-ink border border-whisper rounded-3xl overflow-hidden md:hover:border-whisperStrong transition-colors duration-500"
              >
                {/* 2026-10-19: 16:10 helyett 4:5 / négyzet. A borítók állók (0,56–1,04),
                    a fekvő keret félszemet és kettévágott előtte-utána képet mutatott. */}
                <div class="aspect-[4/5] md:aspect-square overflow-hidden bg-inkRise">
                  <img
                    src={p.data.cover}
                    alt={p.data.coverAlt}
                    width={p.data.coverWidth ?? 800}
                    height={p.data.coverHeight ?? 1000}
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                  />
                </div>
                <div class="p-6 sm:p-7 flex-1">
                  <div class="flex items-center gap-3 text-[11px] uppercase tracking-caps text-creamMute">
                    <span class="text-gold">{p.data.category}</span>
                    <span aria-hidden>·</span>
                    <span>{p.data.readingMinutes} perc</span>
                  </div>
                  <h3 class="mt-3 font-display text-lg sm:text-xl font-medium leading-snug text-cream group-hover:text-gold transition-colors duration-300">
                    {p.data.title}
                  </h3>
                </div>
              </a>
            </RevealCss>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ============ KAPCSOLAT / FOGLALÁS ============ */}
  <SiteContact
    cssReveal
    offer={post.data.category}
    eyebrow="Foglalás"
    heading={'Készen állsz a <em class="display">személyes</em> változásra?'}
    intro="A cikkek a kezdet. A személyes konzultáció a pontos folytatás — gyere be Egressy útra, és üljünk neki, hogy a te helyzetedre szabjuk a tervet."
  />

  <div class="py-10 text-center border-t border-whisper">
    <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="inline-flex items-center gap-2 text-[12px] uppercase tracking-caps font-medium text-cream hover:text-gold transition-colors duration-200">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="M12 5v14"/><path d="M5 12l7-7 7 7"/></svg>
      Vissza az oldal tetejére
    </button>
  </div>

  <SiteFooter />

  {/* A cikk kategóriájához tartozó KONKRÉT ajánlat ragadós sávban. A mért
      12%-os blog-konverzió (szolgáltatás-oldal: 80%) fő oka, hogy egy hosszú
      cikk olvasása közben semmilyen látható CTA nincs a képernyőn: a fejléc
      gombja mobilon nem renderel, az ajánlat-doboz pedig a cikk végén ül.
      Lásd StickyBookBar.astro és src/config/offers.ts. */}
  {/* 2026-09-30: az `offer`-rel a felső sor a pontos Notino-név lesz, és a
      visszatérő kártya is innen épül; a `short` csak tartalék a kivételeknek
      (lézer, esküvői) — lásd StickyBookBar `offer` prop. */}
  <StickyBookBar
    eyebrow={OFFERS[post.data.category].short}
    offer={post.data.category}
    price={OFFERS[post.data.category].price}
  />

  <CookieBanner client:load />
</Layout>

<script>
  // GYIK-akkordeon mozgása. A markup build időben készül (astro.config.mjs,
  // rehypeFaqAccordion); JS nélkül a natív <details> nyit-zár. Itt csak a
  // magasság-animáció, az egyszerre-egy-nyitva viselkedés és a mérés jön hozzá.
  import { track } from '../../lib/track';

  const DURATION = 280;
  const EASE = 'cubic-bezier(0.2, 0.8, 0.2, 1)';
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const running = new WeakMap<HTMLDetailsElement, Animation>();
  // A célállapot külön kell: csukás közben az `open` még igaz, és egy gyors
  // második kattintásnak az új célt kell megfordítania, nem a régit.
  const target = new WeakMap<HTMLDetailsElement, boolean>();

  function animateTo(item: HTMLDetailsElement, open: boolean): void {
    target.set(item, open);
    const panel = item.querySelector<HTMLElement>('.faq-a');
    if (!panel || reduceMotion.matches) {
      item.open = open;
      return;
    }
    // A kiinduló magasságot a futó animáció leállítása ELŐTT mérjük, különben
    // a félúton megfordított mozgás a teljes magasságról ugrana vissza.
    const from = item.open ? panel.offsetHeight : 0;
    running.get(item)?.cancel();
    if (open) item.open = true;
    item.classList.toggle('is-opening', open);
    const to = open ? panel.scrollHeight : 0;
    const anim = panel.animate(
      [{ height: `${from}px` }, { height: `${to}px` }],
      { duration: DURATION, easing: EASE },
    );
    running.set(item, anim);
    anim.onfinish = () => {
      running.delete(item);
      item.classList.remove('is-opening');
      if (!open) item.open = false;
    };
    anim.oncancel = () => item.classList.remove('is-opening');
  }

  document.querySelectorAll<HTMLElement>('.faq-acc').forEach((group) => {
    const items = Array.from(group.querySelectorAll<HTMLDetailsElement>('details.faq-item'));
    items.forEach((item) => {
      const summary = item.querySelector('summary');
      summary?.addEventListener('click', (e) => {
        e.preventDefault();
        const willOpen = !(target.get(item) ?? item.open);
        if (willOpen) {
          items
            .filter((o) => o !== item && (target.get(o) ?? o.open))
            .forEach((o) => animateTo(o, false));
          track('faq_open', {
            question: (summary.textContent ?? '').trim().slice(0, 100),
            page_path: location.pathname,
          });
        }
        animateTo(item, willOpen);
      });
    });
  });
</script>

<style is:global>
  /* ===== Prose typography for blog posts =====
     Scoped to .prose-frubeauty so it doesn't leak to other pages. */
  .prose-frubeauty {
    color: rgb(228 214 194); /* creamSoft */
    font-size: 17px;
    line-height: 1.75;
  }
  .prose-frubeauty > p,
  .prose-frubeauty > h2,
  .prose-frubeauty > h3,
  .prose-frubeauty > ul,
  .prose-frubeauty > ol,
  .prose-frubeauty > blockquote {
    max-width: 65ch;
  }
  @media (min-width: 768px) {
    .prose-frubeauty { font-size: 18px; }
  }

  .prose-frubeauty p {
    margin-block: 1.25em;
  }
  .prose-frubeauty p:first-child { margin-top: 0; }
  .prose-frubeauty > :last-child { margin-bottom: 0; }

  .prose-frubeauty h2 {
    font-family: 'Fraunces', ui-serif, Georgia, serif;
    font-weight: 500;
    color: rgb(245 232 211); /* cream */
    font-size: clamp(1.5rem, 2.6vw, 1.875rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-top: 2.5em;
    margin-bottom: 0.7em;
  }
  .prose-frubeauty h3 {
    font-family: 'Fraunces', ui-serif, Georgia, serif;
    font-weight: 500;
    color: rgb(245 232 211);
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    line-height: 1.3;
    margin-top: 2em;
    margin-bottom: 0.5em;
  }

  .prose-frubeauty strong {
    color: rgb(245 232 211);
    font-weight: 600;
  }
  .prose-frubeauty em {
    font-style: italic;
    color: rgb(245 232 211);
  }


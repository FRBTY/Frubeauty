// ── SEO: FAQPage schema ──────────────────────────────────────────────────
const sminkFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};

// ── SEO: tételes ár-ajánlatok (a schema = a látható tartalom: ár-tábla + csomagok) ──
const pricedOffers = [
  ...priceCategories.flatMap((cat) => cat.items),
  ...packages
    .filter((p) => p.tier !== 'Alap')
    .map((p) => ({ name: `${p.title} ${p.titleAccent}`, price: p.price })),
]
  .filter((it) => /\d/.test(it.price))
  .map((it) => ({
    '@type': 'Offer',
    name: it.name,
    price: it.price.replace(/[^\d]/g, ''),
    priceCurrency: 'HUF',
    availability: 'https://schema.org/InStock',
  }));


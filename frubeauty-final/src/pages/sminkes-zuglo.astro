  { tier: 'Ajánlott', bestFor: 'esküvőd lesz, és a nagy napon nem akarsz meglepetést.', title: 'Menyasszonyi', titleAccent: 'Csomag', subtitle: 'Próbasmink + Menyasszonyi smink együtt', priceOld: '45 000 Ft', price: '40 000 Ft', priceMeta: 'próba + esküvő · 2 alkalom', dailyEquivalent: 'két előre egyeztetett alkalom', savings: '5 000 Ft megtakarítás', duration: '~ 90–120 + 90 perc', features: ['Menyasszonyi próbasmink, dokumentálva','A nagy napi smink — a próba alapján','Bőrelőkészítés Janssen ápolókkal','Touch-up tippek és termékajánlás'], highlight: true, ribbon: 'Próba + nagy nap', footnote: '*A kiszállás díja külön jön, és a helyszínen fizeted.' },
  { tier: 'Prémium', bestFor: 'édesanyád is veled készülne ugyanazon a reggelen.', title: 'Teljes', titleAccent: 'Esküvő', subtitle: 'Menyasszony + örömanya egy napon', priceOld: '60 000 Ft', price: '51 000 Ft', priceMeta: 'menyasszony + örömanya · 1 reggel', dailyEquivalent: 'Az örömanya smink külön 15 000 Ft', savings: '9 000 Ft megtakarítás', duration: '~ 90 + 60–75 perc', features: ['Minden, ami a Menyasszonyi Csomagban','Örömanya smink — diszkrét, korhoz illő','Külön egyeztetés a sorrendről','Prioritásos szezonális időpont'], highlight: false, ribbon: null, footnote: '*A kiszállás díja külön jön, és a helyszínen fizeted.' },
];

const includedPoints = [

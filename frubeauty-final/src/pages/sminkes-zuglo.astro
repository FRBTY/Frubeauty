const sminkServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Esküvői smink Budapest',
  alternateName: ['Menyasszonyi smink', 'Esküvői sminkes'],
  description:
    'Menyasszonyi smink próbasminkkel, örömanya smink és helyszíni kiszállás Budapesten. Próbasmink az esküvő előtt 4–8 héttel, tartós fixálás.',
  provider: {
    '@type': 'BeautySalon',
    '@id': 'https://frubeauty.com/#business',
    name: 'FRUBEAUTY – Pecze-Kovács Fruzsina Kozmetikus',

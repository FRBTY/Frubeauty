const config = { ...siteConfig };

// CÍM (2026-09-29): „Esküvői sminkes Budapest · menyasszonyi smink árak 2026".
// Adat: „esküvői sminkes" 260 keresés/hó, 90 nap alatt 0 megjelenés; „menyasszonyi
// smink" 170/hó, 0,4%. Az „esküvői smink árak" pontos egyezése a H2-ben MARAD.
// VISSZALÉPÉSI SZABÁLY: ha az „esküvői smink árak" 3 hét alatt 3 helynél többet esik
// (28 napos bázis: 6,9), a régi cím jön vissza: „Esküvői smink árak Budapest 2026 –
// 30.000 Ft | FRUBEAUTY". (A 08-21-i tanulság továbbra is áll: „Sminkes Budapest…"

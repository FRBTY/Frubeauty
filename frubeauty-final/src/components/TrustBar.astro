---
/**
 * Bizalom-sáv a hero alatt — közös komponens a kezdőlapnak és a money page-eknek.
 *
 * MIÉRT ÍRÓDOTT ÚJRA: a sáv négy oldalon volt bemásolva, és mind a négyen az
 * ELSŐ cella — a legértékesebb hely a hero után — csak annyit mondott, hogy
 * „Google", alatta „Értékelések megnyitása". Vagyis a szalon legerősebb
 * bizonyítéka (5,0 átlag 60+ értékelésből) egyetlen semleges márkanévként
 * jelent meg, szám nélkül. A bizonyíték nem az, hogy létezik Google-profil,
 * hanem hogy mi áll rajta.
 *
 * A „60+" szándékosan kerekített: a pontos szám hetente nő, egy beégetett
 * „62" pedig hónapok múlva már alulmérné a szalont. A fölfelé kerekítés
 * tiltott, a lefelé nem — a „60+" mindig igaz marad.
 *
 * A csillag NEM aggregateRating strukturált adat: azt a Layout szándékosan nem
 * emitálja (self-serving jelölés, manual action kockázat). Ez tisztán vizuális,
 * a Google Cégprofilra mutató linkkel — vagyis ellenőrizhető állítás.
 */
import { siteConfig } from '../config/site';

export interface TrustItem {
  /** Nagy, hangsúlyos érték — szám vagy rövid szó. */
  value: string;
  /** Kisbetűs magyarázó sor alatta. */
  label: string;
  /** Ha van, a label linkké válik. */
  href?: string;
}

interface Props {
  /** A 2–4. cella. Az elsőt (értékelés) mindig a komponens adja. */
  items: TrustItem[];
}

const { items } = Astro.props;
const config = { ...siteConfig };
---

<section class="border-y border-whisper bg-inkSoft">
  <div class="max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12 py-10">
    <div class="zero-js-fade grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-6">
      <div class="flex flex-col items-center md:items-start">
        <span
          class="text-2xl font-display font-medium tracking-tight text-gold inline-flex items-baseline gap-1.5"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="translate-y-px"
            aria-hidden="true"
          >
            <path d="M12 2l2.39 7.36H22l-6.18 4.49L18.21 22 12 17.5 5.79 22l2.39-8.15L2 9.36h7.61z" />
          </svg>
          5,0
        </span>
        <span class="text-[11px] uppercase tracking-caps text-creamMute mt-2 text-center md:text-left">
          <a
            href={config.googleReviewsUrl}
            target="_blank"
            rel="noopener"
            class="hover:text-cream transition-colors"
          >
            60+ Google-értékelés &#8594;
          </a>
        </span>
      </div>

      {items.map((item) => (
        <div class="flex flex-col items-center md:items-start">
          <span class="text-2xl font-display font-medium tracking-tight text-cream">
            {item.value}
          </span>
          <span class="text-[11px] uppercase tracking-caps text-creamMute mt-2 text-center md:text-left">
            {item.href ? (
              <a
                href={item.href}
                target={item.href.startsWith('http') ? '_blank' : undefined}
                rel={item.href.startsWith('http') ? 'noopener' : undefined}
                class="hover:text-cream transition-colors"
              >
                {item.label}
              </a>
            ) : (
              item.label
            )}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

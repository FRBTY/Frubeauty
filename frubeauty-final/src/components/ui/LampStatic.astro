---
/**
 * LampStatic — CSS-only lamp beam component.
 * Replaces the framer-motion LampContainer on the hero section to eliminate
 * lamp.js (7.62 KiB) from the critical request chain.
 * All animations are pure CSS keyframes — zero JS, zero hydration.
 */
interface Props {
  className?: string;
}
const { className = '' } = Astro.props;
const rootClass = `lamp-root relative flex flex-col items-center justify-center overflow-hidden bg-ink w-full z-0 min-h-[88vh] sm:min-h-[92vh] ${className}`.trim();
---

<div class={rootClass}>
  <!-- beam + glow layer -->
  <div class="relative flex w-full flex-1 scale-y-125 items-center justify-center isolate z-0">

    <!-- Left cone -->
    <div
      class="lamp-cone-left absolute inset-auto right-1/2 h-56 overflow-visible from-gold via-transparent to-transparent text-cream"
      style="background-image: conic-gradient(from 70deg at center top, var(--tw-gradient-stops))"
    >
      <div class="absolute w-full left-0 bg-ink h-40 bottom-0 z-20" style="-webkit-mask-image: linear-gradient(to top, white, transparent); mask-image: linear-gradient(to top, white, transparent);"></div>
      <div class="absolute w-40 h-full left-0 bg-ink bottom-0 z-20" style="-webkit-mask-image: linear-gradient(to right, white, transparent); mask-image: linear-gradient(to right, white, transparent);"></div>
    </div>

    <!-- Right cone -->
    <div
      class="lamp-cone-right absolute inset-auto left-1/2 h-56 from-transparent via-transparent to-gold text-cream"
      style="background-image: conic-gradient(from 290deg at center top, var(--tw-gradient-stops))"
    >
      <div class="absolute w-40 h-full right-0 bg-ink bottom-0 z-20" style="-webkit-mask-image: linear-gradient(to left, white, transparent); mask-image: linear-gradient(to left, white, transparent);"></div>
      <div class="absolute w-full right-0 bg-ink h-40 bottom-0 z-20" style="-webkit-mask-image: linear-gradient(to top, white, transparent); mask-image: linear-gradient(to top, white, transparent);"></div>
    </div>

    <!-- Blur mask behind the beam -->
    <div class="absolute top-1/2 h-48 w-full translate-y-12 scale-x-150 bg-ink blur-2xl"></div>

    <!-- Gold glow bulb — az opacity 0,4-ről 0,3-ra csökkent: a 64 px-re elmosott
         arany folt pont a H1 első sora alatt ült, és rgb(89,66,39)-re emelte a
         hátteret. Az arany <em> ("Zuglóban") így csak 3,2:1 kontrasztot adott,
         azaz optikailag beleolvadt a fénybe. 0,3-nál rgb(73,55,33) a háttér —
         a lámpa hangulata megmarad, a címsor viszont elválik tőle. -->
    <div class="absolute inset-auto z-50 h-36 w-[28rem] -translate-y-1/2 rounded-full bg-gold opacity-30 blur-3xl"></div>

    <!-- Inner bright bulb -->
    <div class="lamp-bulb absolute inset-auto z-30 h-36 w-64 -translate-y-[6rem] rounded-full bg-goldGlow blur-2xl"></div>

    <!-- Hair-thin gold rail -->
    <div class="lamp-rail absolute inset-auto z-50 h-px w-[30rem] -translate-y-[7rem] bg-goldSoft"></div>

    <!-- Top ink mask — lágy alsó él: a maszk alja kifut (mask-image fade), így a
         fénynyaláb teteje nem kemény vízszintes vonalként vágódik el ("doboz"),
         hanem a homályos izzó finoman átolvad a sötétbe. -->
    <div
      class="absolute inset-auto z-40 h-44 w-full -translate-y-[12.5rem] bg-ink"
      style="-webkit-mask-image: linear-gradient(to bottom, white 45%, transparent); mask-image: linear-gradient(to bottom, white 45%, transparent);"
    ></div>
  </div>

  <!-- Content slot -->
  <div class="relative z-50 flex -translate-y-36 sm:-translate-y-44 flex-col items-center px-5 w-full">
    <slot />
  </div>
</div>

<style>
  /* A belépő animáció opacity-fade (kompozitált) — NEM width-et animál, ami
     minden képkockán layoutot kényszerítene a hero kritikus festési ablakában.
     A lámpa a végső méretén renderel, csak finoman beúszik. */
  @keyframes lampFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .lamp-cone-left,
  .lamp-cone-right {
    width: 30rem;
    opacity: 1;
    animation: lampFadeIn 0.8s 0.3s cubic-bezier(0.4, 0, 0.2, 1) both;
    /* Lágy felső él: a fénykúp teteje ne kemény vízszintes vonalként induljon
       (ez adta a "dobozos" hatást), hanem finoman ússzon ki a homályos izzóba.
       A maszk a kúp tetejét átlátszóra fokozza, így a nyaláb teteje izzás, nem él. */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.35) 22%, #fff 55%);
    mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.35) 22%, #fff 55%);
  }
  .lamp-bulb {
    animation: lampFadeIn 0.8s 0.3s cubic-bezier(0.4, 0, 0.2, 1) both;
  }
  .lamp-rail {
    animation: lampFadeIn 0.8s 0.3s cubic-bezier(0.4, 0, 0.2, 1) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .lamp-cone-left,
    .lamp-cone-right,
    .lamp-bulb,
    .lamp-rail {
      animation: none;
    }
  }
</style>

---
/**
 * Reusable contact / booking section. Drop-in for any subpage that needs a
 * conversion block + nyitvatartás + cím. Kept identical across pages so the
 * vendég always finds the same data in the same place — predictable beats clever.
 */
import { Reveal } from './Reveal';
import RevealCss from './RevealCss.astro';
import SiteContactBooking from './SiteContactBooking.astro';
import SiteContactInfo from './SiteContactInfo.astro';
import type { OfferCategory } from '../config/offers';

interface Props {
  /** Headline above the booking CTA. Use the *display* em-tag for the italic accent. */
  heading?: string;
  /** Eyebrow caption above the headline. */
  eyebrow?: string;
  /** Optional supporting paragraph after the headline. */
  intro?: string;
  /**
   * Az oldal saját szolgáltatás-kategóriája. Ettől írja ki a kockázatoldó sor,
   * hogy a Notino 25 tételes listájában MELYIK sort keresse a látogató.
   * Szolgáltatás-oldalon mindig add meg; általános oldalon (rólam, 404) hagyd el.
   */
  offer?: OfferCategory;
  /**
   * true: a beúszás CSS-sel megy (RevealCss), React/framer-motion nélkül. A blogcikk
   * használja (LCP/főszál, 2026-10-20). A szolgáltatás-oldalak alapértéke false,
   * ott a kimenet változatlan.
   */
  cssReveal?: boolean;
}

const {
  heading = 'Találkozzunk az <em class="display">Egressy</em> úton.',
  eyebrow = 'Foglalás',
  intro = 'Online foglalási rendszer 0–24 órában, válasz munkanapokon pár órán belül.',
  offer,
  cssReveal = false,
} = Astro.props;
---

<section id="kapcsolat" class="py-20 sm:py-28 bg-inkDeep">
  <div class="max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16">
      {cssReveal ? (
        <>
          <RevealCss class="lg:col-span-6">
            <SiteContactBooking heading={heading} eyebrow={eyebrow} intro={intro} offer={offer} />
          </RevealCss>
          <RevealCss class="lg:col-span-6 grid sm:grid-cols-2 gap-6 lg:gap-8" delay={0.1}>
            <SiteContactInfo />
          </RevealCss>
        </>
      ) : (
        <>
          <Reveal client:visible as="div" className="lg:col-span-6">
            <SiteContactBooking heading={heading} eyebrow={eyebrow} intro={intro} offer={offer} />
          </Reveal>
          <Reveal client:visible as="div" className="lg:col-span-6 grid sm:grid-cols-2 gap-6 lg:gap-8" delay={0.1}>
            <SiteContactInfo />
          </Reveal>
        </>
      )}
    </div>
  </div>
</section>

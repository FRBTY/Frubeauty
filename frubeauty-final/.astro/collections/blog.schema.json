{
  "$ref": "#/definitions/blog",
  "definitions": {
    "blog": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 8,
          "maxLength": 120
        },
        "excerpt": {
          "type": "string",
          "minLength": 20,
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "enum": [
            "Szempilla",
            "Arckezelés",
            "Alkalmi smink",
            "Bőrápolás"
          ]
        },
        "readingMinutes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "publishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "updatedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "cover": {
          "type": "string",
          "pattern": "^\\/"
        },
        "coverAlt": {
          "type": "string",
          "minLength": 8
        },
        "slug": {
          "type": "string"
        },
        "draft": {
          "type": "boolean",
          "default": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "excerpt",
        "category",
        "readingMinutes",
        "publishedAt",
        "cover",
        "coverAlt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
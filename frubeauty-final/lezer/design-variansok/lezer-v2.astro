---
/**
 * VARIÁNS 2 — „A DOSSZIÉ”
 * =============================================================================
 * A KAR: kockázat-oldás. A vbro-marketing vakfolt-fájlának szépészeti szabálya
 * szerint ebben az iparágban a domináns súrlódás NEM motivációs, hanem KOCKÁZATI:
 * a vendég nem attól fél, hogy nem lesz szép, hanem hogy elrontják. Vágykeltés
 * helyett tehát bizonyítékot kell adni — és nem állítást, hanem FORRÁST.
 *
 * Ezért ez az oldal nem hirdetés, hanem dosszié. Minden blokk sorszámot kap, és
 * minden blokk alján ott a „FORRÁS:” sor, ami megmondja, honnan tudjuk. Ha egy
 * állítás mögött nincs forrás, nem kerül fel — és ahol hiány van (nincs saját
 * előtte-utána kép), az is külön sorszámot kap, nem elhallgatást.
 *
 * Leckék: L9 érték bizonyítása, L13 hitelesség-átvitel, L16–L17 (a hossz a
 * bizonyítékok DARABSZÁMÁBÓL jön, nem a mondathosszból), L8 konkrétság,
 * L33 whitespace. Szándékosan NINCS: sürgetés, áthúzott ár, „megtakarítás” badge.
 *
 * VIZUÁLIS NYELV: szögletes sarkok, hajszálvonalak, verzál mikro-címkék,
 * sorszámozott regiszter. Az arany csak indexjelként dolgozik, nem díszként.
 *
 * ELŐNÉZETI OLDAL: noindex + a sitemapból kizárva.
 */
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteContact from '../components/SiteContact.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { Reveal } from '../components/Reveal';
import { MagneticCTA } from '../components/MagneticCTA';
import FAQList from '../components/FAQList.astro';
import BookingAssurance from '../components/BookingAssurance.astro';
import StickyBookBar from '../components/StickyBookBar.astro';
import { CookieBanner } from '../components/CookieBanner';
import { LaserDiodeAnimation } from '../components/lezer/LaserDiodeAnimation';
import { siteConfig, relFor } from '../config/site';
import {
  zones, packages, machineFacts, processSteps, worksFor, worksNotFor, commitments,
  faqs, testimonials, crossSell, images, faqSchema, serviceSchema, howToSchema,
} from '../data/lezer';

const config = { ...siteConfig };

// A dosszié tartalomjegyzéke. Egy helyen definiálva, hogy az index és a
// szekció-fejlécek ne tudjanak elcsúszni egymástól.
const index = [
  { n: '01', id: 'b01', title: 'A gép', note: 'mivel dolgozom' },
  { n: '02', id: 'b02', title: 'A mechanizmus', note: 'miért 6–8 alkalom' },
  { n: '03', id: 'b03', title: 'A protokoll', note: 'mi történik, sorrendben' },
  { n: '04', id: 'b04', title: 'A korlátok', note: 'kin nem működik' },
  { n: '05', id: 'b05', title: 'Az árak', note: 'tételesen' },
  { n: '06', id: 'b06', title: 'Amit vállalok', note: 'három ellenőrizhető feltétel' },
  { n: '07', id: 'b07', title: 'A hiány', note: 'amit nem tudok megmutatni' },
];
---

<Layout
  title="[V2 · A DOSSZIÉ] Lézeres szőrtelenítés Budapest – árak 11.000 Ft-tól | FRUBEAUTY"
  description="Dióda lézeres szőrtelenítés Budapesten, forrásmegjelöléssel: a gép, a protokoll, a korlátok és az árak — tételesen. Hónalj sorozatban 11.000 Ft alkalmanként."
  robots="noindex, nofollow"
  additionalSchemas={[faqSchema, serviceSchema, howToSchema]}
>
  <SiteHeader />

  {/* ── Hero: kezelési lap ───────────────────────────────────────────────────
       Nem „hirdetés-hero”, hanem fejléc. A négy adatmező azonnal megválaszolja
       azt a négy kérdést, amit a látogató a fejében visz (mi ez, mivel, mennyi,
       hol) — a tudás átka (vakfoltok §4) elleni legolcsóbb védekezés. */}
  <section class="relative pt-[calc(var(--header-h)+1.5rem)] sm:pt-[calc(var(--header-h)+5rem)] pb-14 sm:pb-20">
    <div class="max-w-[1180px] mx-auto px-5 sm:px-8 lg:px-12">
      <div class="hero-reveal border-t-2 border-cream/80 pt-6">
        <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 text-[11px] uppercase tracking-caps text-creamMute">
          <span>FRUBEAUTY · Kezelési lap</span>
          <span>1143 Budapest, Egressy út 16.</span>
          <span>Kiállítva: 2026. szeptember</span>
        </div>

        <h1 class="mt-9 font-display font-light text-cream leading-[1.05] tracking-tightest- max-w-[20ch]" style="font-size: clamp(2.1rem, 5.4vw, 4rem);">Lézeres szőrtelenítés Budapesten, <em class="display">forrásmegjelöléssel</em>.</h1>

        <p class="mt-7 text-base sm:text-lg text-creamSoft leading-[1.75] max-w-[62ch]">Ezen az oldalon minden állítás mellett ott van, honnan tudom. Ahol nincs bizonyítékom, azt is kiírom — külön sorszámmal. Nem azért, mert szép; azért, mert ebben a szakmában <span class="text-cream">a hiány beismerése az egyetlen állítás, amit nem lehet meghamisítani.</span></p>

        {/* Adatmezők — ez a rész a „hirdetés” helyett adatlapként olvas. */}
        <dl class="mt-11 grid sm:grid-cols-2 lg:grid-cols-4 border-t border-whisperStrong">
          {[
            { k: 'Eljárás', v: 'Dióda lézer', s: 'tartós szőrcsökkentés' },
            { k: 'Hullámhossz', v: '755 · 808 · 1064', s: 'nanométer, egyszerre' },
            { k: 'Ár, sorozatban', v: '11 000 Ft-tól', s: 'alkalmanként, hónalj / S zóna' },
            { k: 'Előre fizetendő', v: '0 Ft', s: 'se bérlet, se kártyaadat' },
          ].map((f) => (
            <div class="border-b sm:border-b-0 sm:border-r border-whisper last:border-r-0 py-5 sm:py-6 sm:pr-6 first:sm:pl-0 sm:pl-6">
              <dt class="text-[10.5px] uppercase tracking-caps text-creamMute">{f.k}</dt>
              <dd class="mt-2 font-display text-xl sm:text-2xl text-cream leading-tight">{f.v}</dd>
              <dd class="mt-1.5 text-[12px] text-creamMute leading-snug">{f.s}</dd>
            </div>
          ))}
        </dl>

        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a href={config.booking} target="_blank" rel={relFor(config.booking)} class="inline-flex items-center justify-center px-7 py-3.5 text-[12px] uppercase tracking-caps font-medium bg-gold text-ink hover:bg-goldSoft active:translate-y-px transition-colors duration-200">Próbafoltot foglalok · 5 000 Ft</a>
          <a href="#b05" class="inline-flex items-center justify-center px-7 py-3.5 text-[12px] uppercase tracking-caps font-medium border border-whisperStrong text-cream hover:bg-white/5 transition-colors duration-200">05 · Az árak</a>
          <span class="inline-flex items-center border border-whisperStrong px-3 py-1.5 text-[11px] uppercase tracking-caps text-creamSoft">Kizárólag női vendégek</span>
        </div>
        <BookingAssurance class="mt-7" offer="Lézer" />
      </div>
    </div>
  </section>

  {/* ── Tartalomjegyzék ────────────────────────────────────────────────────── */}
  <section class="py-10 sm:py-14 border-y border-whisper bg-inkSoft">
    <div class="max-w-[1180px] mx-auto px-5 sm:px-8 lg:px-12">
      <p class="text-[11px] uppercase tracking-caps text-creamMute mb-6">Tartalom</p>
      <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8">
        {index.map((it) => (
          <li class="border-t border-whisper">
            <a href={`#${it.id}`} class="group flex items-baseline gap-3 py-3.5 hover:text-cream transition-colors">
              <span class="font-display text-gold text-[15px] tabular-nums">{it.n}</span>
              <span class="text-[14px] text-creamSoft group-hover:text-cream transition-colors">{it.title}</span>
              <span class="ml-auto text-[11px] text-creamMute/70 hidden lg:inline">{it.note}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ── 01 · A gép ─────────────────────────────────────────────────────────── */}
  <section id="b01" class="py-20 sm:py-28 scroll-mt-28">
    <div class="max-w-[1180px] mx-auto px-5 sm:px-8 lg:px-12">
      <Reveal client:visible as="div" className="border-t border-whisperStrong pt-7 mb-12">
        <p class="font-display text-gold text-lg tabular-nums">01</p>
        <h2 class="mt-3 font-display font-light leading-[1.1] tracking-tight text-cream" style="font-size: clamp(1.75rem, 3.8vw, 2.75rem);">A gép — és hogy ez neked <em class="display">mit ad</em>.</h2>
      </Reveal>

      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-start">
        <div class="lg:col-span-6">
          <Reveal client:visible as="div">
            <figure class="ring-1 ring-white/10 bg-inkRise overflow-hidden">
              <img src={images.machine} alt="A Soprano Titanium dióda lézer a FRUBEAUTY kezelőjében — 1143 Budapest, Egressy út 16., Zugló" width="1100" height="1264" loading="eager" fetchpriority="high" decoding="async" class="w-full h-auto" />
              <figcaption class="px-5 py-3.5 text-[11px] uppercase tracking-caps text-creamMute border-t border-whisper">Bizonyíték 01/a — a gép a kezelőmben</figcaption>
            </figure>
          </Reveal>
          <Reveal client:visible as="div" delay={0.08}>
            <figure class="mt-5 ring-1 ring-white/10 bg-inkRise overflow-hidden">
              <img src={images.fitzpatrick} alt="Bőrtípus-beállítás a Fitzpatrick-skálán a Soprano Titanium kijelzőjén — FRUBEAUTY, Budapest" width="1300" height="1144" loading="lazy" decoding="async" class="w-full h-auto" />
              <figcaption class="px-5 py-3.5 text-[11px] uppercase tracking-caps text-creamMute border-t border-whisper">Bizonyíték 01/b — a te bőrtípusod, beállítva</figcaption>
            </figure>
          </Reveal>
        </div>

        <div class="lg:col-span-6">
          {machineFacts.map((m, i) => (
            <Reveal client:visible as="div" delay={0.05 * i}>
              <div class="border-t border-whisper py-7 first:border-t-0 first:pt-0">
                <p class="text-[11px] uppercase tracking-caps text-gold">Jellemző</p>
                <p class="mt-2 font-display text-xl sm:text-2xl text-cream leading-snug">{m.feature}</p>
                <p class="mt-3 text-[11px] uppercase tracking-caps text-creamMute">Neked ez azt jelenti</p>
                <p class="mt-2 text-[15px] sm:text-base text-creamSoft leading-[1.75]">{m.benefit}</p>
              </div>
            </Reveal>
          ))}
          <p class="mt-6 border-t border-whisperStrong pt-4 text-[12px] text-creamMute leading-relaxed">
            <span class="uppercase tracking-caps text-creamSoft">Forrás:</span> a gép saját kijelzőjéről készült
            fotóim (fent). A gyártóra vonatkozó állítást — cégnév, származási ország, hatósági jóváhagyás —
            szándékosan NEM teszek, mert arra nincs a kezemben dokumentum. A megnevezés, a hullámhosszak és a
            fotó a teljes állításkészlet.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 02 · A mechanizmus ─────────────────────────────────────────────────── */}
  <section id="b02" class="py-20 sm:py-28 bg-inkSoft scroll-mt-28">
    <div class="max-w-[1180px] mx-auto px-5 sm:px-8 lg:px-12">
      <Reveal client:visible as="div" className="border-t border-whisperStrong pt-7 mb-12">
        <p class="font-display text-gold text-lg tabular-nums">02</p>
        <h2 class="mt-3 font-display font-light leading-[1.1] tracking-tight text-cream" style="font-size: clamp(1.75rem, 3.8vw, 2.75rem);">A mechanizmus — miért nem elég <em class="display">egy alkalom</em>.</h2>
        <p class="mt-5 text-creamSoft leading-[1.7] max-w-[62ch]">Ez a kategória legdrágább kérdése, és a legtöbb árlista nem válaszol rá. Az ábra léptethető: koppints a fázisokra.</p>
      </Reveal>
      <LaserDiodeAnimation client:visible bare />
      <p class="mt-6 border-t border-whisperStrong pt-4 text-[12px] text-creamMute leading-relaxed max-w-[72ch]">
        <span class="uppercase tracking-caps text-creamSoft">Forrás:</span> a szőrciklus (anagén–katagén–telogén)
        szakmai alapismeret; az ábra sematikus, a mechanizmus bemutatására készült. Nem orvosi illusztráció és
        nem konkrét kezelési eredmény.
      </p>
    </div>
  </section>

  {/* ── 03 · A protokoll ───────────────────────────────────────────────────── */}
  <section id="b03" class="py-20 sm:py-28 scroll-mt-28">
    <div class="max-w-[1180px] mx-auto px-5 sm:px-8 lg:px-12">
      <Reveal client:visible as="div" className="border-t border-whisperStrong pt-7 mb-12">
        <p class="font-display text-gold text-lg tabular-nums">03</p>
        <h2 class="mt-3 font-display font-light leading-[1.1] tracking-tight text-cream" style="font-size: clamp(1.75rem, 3.8vw, 2.75rem);">A protokoll — <em class="display">sorrendben</em>, lépésenként.</h2>
      </Reveal>
      <ol>
        {processSteps.map((s, i) => (
          <Reveal client:visible as="div" delay={0.04 * i}>
            <li class="grid sm:grid-cols-12 gap-x-8 gap-y-3 border-t border-whisper py-7">
              <div class="sm:col-span-2">
                <p class="font-display text-3xl font-light text-gold tabular-nums">{s.step}</p>
              </div>
              <div class="sm:col-span-3">
                <h3 class="font-medium text-lg text-cream leading-snug">{s.title}</h3>
              </div>
              <div class="sm:col-span-7">
                <p class="text-[15px] sm:text-base text-creamSoft leading-[1.75]">{s.body}</p>
              </div>
            </li>
          </Reveal>
        ))}
      </ol>
      <p class="mt-6 border-t border-whisperStrong pt-4 text-[12px] text-creamMute leading-relaxed max-w-[72ch]">
        <span class="uppercase tracking-caps text-creamSoft">Forrás:</span> a saját kezelési rendem. A próbafolt
        és a 24–48 órás várakozás nem opció, hanem az első alkalom része.
      </p>
    </div>
  </section>

  {/* ── 04 · A korlátok ────────────────────────────────────────────────────── */}
  <section id="b04" class="py-20 sm:py-28 bg-inkSoft scroll-mt-28">
    <div class="max-w-[1180px] mx-auto px-5 sm:px-8 lg:px-12">
      <Reveal client:visible as="div" className="border-t border-whisperStrong pt-7 mb-12">
        <p class="font-display text-gold text-lg tabular-nums">04</p>
        <h2 class="mt-3 font-display font-light leading-[1.1] tracking-tight text-cream" style="font-size: clamp(1.75rem, 3.8vw, 2.75rem);">A korlátok — <em class="display">kin nem működik</em>.</h2>
        <p class="mt-5 text-creamSoft leading-[1.7] max-w-[62ch]">Ez a leghosszabb blokk az oldalon, és ez szándékos. Ha a te szálad nem olyan, amin a lézer dolgozni tud, azt jobb most megtudnod, mint a harmadik alkalom után.</p>
      </Reveal>
      <div class="grid lg:grid-cols-2 gap-x-14">
        <div>
          <p class="text-[11px] uppercase tracking-caps text-gold border-b border-whisperStrong pb-3">Ezeken dolgozik</p>
          <ul>
            {worksFor.map((w) => (
              <li class="border-b border-whisper py-4 text-[15px] text-creamSoft leading-[1.7]">{w}</li>
            ))}
          </ul>
        </div>
        <div class="mt-12 lg:mt-0">
          <p class="text-[11px] uppercase tracking-caps text-creamMute border-b border-whisperStrong pb-3">Ezeken nem</p>
          <ul>
            {worksNotFor.map((w) => (
              <li class="border-b border-whisper py-4 text-[15px] text-creamSoft leading-[1.7]">{w}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ── 05 · Az árak ───────────────────────────────────────────────────────── */}
  <section id="b05" class="py-20 sm:py-28 scroll-mt-28">
    <div class="max-w-[1180px] mx-auto px-5 sm:px-8 lg:px-12">
      <Reveal client:visible as="div" className="border-t border-whisperStrong pt-7 mb-12">
        <p class="font-display text-gold text-lg tabular-nums">05</p>
        <h2 class="mt-3 font-display font-light leading-[1.1] tracking-tight text-cream" style="font-size: clamp(1.75rem, 3.8vw, 2.75rem);">Lézeres szőrtelenítés <em class="display">árak</em> — tételesen.</h2>
        <p class="mt-5 text-creamSoft leading-[1.7] max-w-[62ch]">A sorozat-ár nagyjából az egyalkalmas ár kétharmada: hat alkalomból kettőt nem fizetsz ki. Nincs áthúzott ár és nincs akció — ez az árlista.</p>
      </Reveal>

      <div class="sm:hidden">
        {zones.map((z) => (
          <div class="border-t border-whisper py-5">
            <div class="flex items-center justify-between gap-4">
              <span class="font-display text-gold text-lg">{z.tag}</span>
              <span class="text-[11px] uppercase tracking-caps text-creamMute">{z.time}</span>
            </div>
            <p class="mt-2.5 text-[14px] text-creamSoft leading-snug">{z.areas}</p>
            <div class="mt-3 flex items-end justify-between gap-4">
              <div><p class="text-[10px] uppercase tracking-caps text-creamMute">Egy alkalom</p><p class="font-display text-xl text-cream mt-1">{z.single}</p></div>
              <div class="text-right"><p class="text-[10px] uppercase tracking-caps text-gold">Sorozatban</p><p class="font-display text-xl text-gold mt-1">{z.serial}</p></div>
            </div>
          </div>
        ))}
      </div>

      <div class="hidden sm:block overflow-x-auto">
        <table class="w-full min-w-[640px] border-collapse text-left">
          <thead>
            <tr class="border-b border-whisperStrong">
              <th class="py-4 pr-4 text-[11px] uppercase tracking-caps text-creamMute font-normal">Zóna</th>
              <th class="py-4 pr-4 text-[11px] uppercase tracking-caps text-creamMute font-normal">Területek</th>
              <th class="py-4 pr-4 text-[11px] uppercase tracking-caps text-creamMute font-normal whitespace-nowrap">Idő</th>
              <th class="py-4 pr-4 text-[11px] uppercase tracking-caps text-creamMute font-normal whitespace-nowrap">Egy alkalom</th>
              <th class="py-4 text-[11px] uppercase tracking-caps text-gold font-normal whitespace-nowrap">Sorozatban / alkalom</th>
            </tr>
          </thead>
          <tbody>
            {zones.map((z) => (
              <tr class="border-b border-whisper align-top">
                <td class="py-5 pr-4 font-display text-gold text-lg">{z.tag}</td>
                <td class="py-5 pr-4 text-[14px] sm:text-[15px] text-creamSoft leading-snug max-w-[32ch]">{z.areas}</td>
                <td class="py-5 pr-4 text-[13px] text-creamMute whitespace-nowrap">{z.time}</td>
                <td class="py-5 pr-4 font-display text-xl text-cream whitespace-nowrap tabular-nums">{z.single}</td>
                <td class="py-5 font-display text-xl text-gold whitespace-nowrap tabular-nums">{z.serial}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {/* Csomagok — kártya helyett összevetés-táblázat, ugyanabban a nyelvben. */}
      <div class="mt-16">
        <p class="text-[11px] uppercase tracking-caps text-gold mb-6">Összevont sorozatok</p>
        <div class="grid lg:grid-cols-3 gap-x-10">
          {packages.map((p) => (
            <Reveal client:visible as="div">
              <div class={`border-t-2 pt-6 pb-8 ${p.highlight ? 'border-gold' : 'border-whisperStrong'}`}>
                <p class={`text-[11px] uppercase tracking-caps ${p.highlight ? 'text-gold' : 'text-creamMute'}`}>{p.tier}</p>
                <h3 class="mt-3 font-display font-light text-cream leading-tight" style="font-size: clamp(1.4rem, 2.4vw, 1.75rem);">{p.title} <em class="display">{p.titleAccent}</em></h3>
                <p class="mt-2 text-[13px] text-creamMute leading-snug">{p.contains}</p>
                <dl class="mt-6 space-y-2.5">
                  <div class="flex items-baseline justify-between gap-4 border-b border-whisper pb-2.5">
                    <dt class="text-[12px] text-creamMute">Alkalmanként</dt>
                    <dd class="font-display text-2xl text-cream tabular-nums">{p.perVisit}</dd>
                  </div>
                  <div class="flex items-baseline justify-between gap-4 border-b border-whisper pb-2.5">
                    <dt class="text-[12px] text-creamMute">Hat alkalom</dt>
                    <dd class="text-[15px] text-cream tabular-nums">{p.total}</dd>
                  </div>
                  <div class="flex items-baseline justify-between gap-4 border-b border-whisper pb-2.5">
                    <dt class="text-[12px] text-creamMute">Külön véve</dt>
                    <dd class="text-[15px] text-creamMute tabular-nums">{p.priceOld}</dd>
                  </div>
                  <div class="flex items-baseline justify-between gap-4">
                    <dt class="text-[12px] text-creamMute">Egy alkalom hossza</dt>
                    <dd class="text-[15px] text-creamSoft">{p.duration.replace('~ ', '')}</dd>
                  </div>
                </dl>
                <p class="mt-5 text-[13px] text-creamSoft leading-[1.7]"><span class="text-gold">Neked való, ha</span> {p.bestFor}</p>
                <div class="mt-6">
                  <MagneticCTA href={config.booking} external variant={p.highlight ? 'primary' : 'secondary'}>Próbafoltot foglalok</MagneticCTA>
                </div>
              </div>
            </Reveal>
          ))}
        </div>
        <p class="mt-8 border-t border-whisperStrong pt-4 text-[12px] text-creamMute leading-relaxed max-w-[72ch]">
          <span class="uppercase tracking-caps text-creamSoft">Forrás:</span> a „külön véve” oszlop a saját fenti
          árlistám alapján számolva — nem korábbi, magasabb ár. Az összevont ár indoka valódi: három zóna egy
          időpontban egy időpont, nem három.
        </p>
      </div>
    </div>
  </section>

  {/* ── 06 · Amit vállalok ─────────────────────────────────────────────────── */}
  <section id="b06" class="py-20 sm:py-28 bg-inkSoft scroll-mt-28">
    <div class="max-w-[1180px] mx-auto px-5 sm:px-8 lg:px-12">
      <Reveal client:visible as="div" className="border-t border-whisperStrong pt-7 mb-12">
        <p class="font-display text-gold text-lg tabular-nums">06</p>
        <h2 class="mt-3 font-display font-light leading-[1.1] tracking-tight text-cream" style="font-size: clamp(1.75rem, 3.8vw, 2.75rem);">Amit vállalok — három <em class="display">ellenőrizhető</em> feltétel.</h2>
        <p class="mt-5 text-creamSoft leading-[1.7] max-w-[62ch]">Ez nem garancia, és nem is fogom annak nevezni. Három konkrét feltétel, amit egy egyszemélyes kozmetikában be is lehet tartani — és amit te is le tudsz ellenőrizni.</p>
      </Reveal>
      {commitments.map((c, i) => (
        <Reveal client:visible as="div" delay={0.04 * i}>
          <div class="grid sm:grid-cols-12 gap-x-8 gap-y-3 border-t border-whisper py-7">
            <p class="sm:col-span-2 font-display text-3xl font-light text-gold tabular-nums">{c.n}</p>
            <h3 class="sm:col-span-4 font-medium text-lg text-cream leading-snug">{c.title}</h3>
            <p class="sm:col-span-6 text-[15px] sm:text-base text-creamSoft leading-[1.75]">{c.body}</p>
          </div>
        </Reveal>
      ))}
    </div>
  </section>

  {/* ── 07 · A hiány ───────────────────────────────────────────────────────── */}
  <section id="b07" class="py-20 sm:py-28 scroll-mt-28">
    <div class="max-w-[1180px] mx-auto px-5 sm:px-8 lg:px-12">
      <Reveal client:visible as="div" className="border-t border-whisperStrong pt-7 mb-12">
        <p class="font-display text-gold text-lg tabular-nums">07</p>
        <h2 class="mt-3 font-display font-light leading-[1.1] tracking-tight text-cream" style="font-size: clamp(1.75rem, 3.8vw, 2.75rem);">A hiány — amit <em class="display">nem</em> tudok megmutatni.</h2>
      </Reveal>
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-start">
        <Reveal client:visible as="div" className="lg:col-span-7">
          <div class="space-y-5 text-creamSoft leading-[1.75] text-[16px] sm:text-[17px] max-w-[58ch]">
            <p>Erről a gépről még nincs saját előtte-utána képem, és nincs egyetlen lézeres vendég-véleményem sem. Ez így igaz, és nem fogok idegen képeket kirakni helyette.</p>
            <p>Amit meg tudok mutatni: <span class="text-cream">a saját fotóidat</span>. Minden alkalom előtt ugyanabban a fényben, ugyanarról a területről készítek egy képet — a harmadik alkalomra a saját telefonodon látod, mi történt.</p>
            <p><span class="text-cream">A lézer új. Az ember nem.</span> Öt éve dolgozom Zuglóban, az Egressy úton, ★5,0 átlaggal 60-nál több Google-értékelésből. Ezek nem lézeres vélemények — azt viszont pontosan leírják, hogyan dolgozom.</p>
          </div>

          {/* A vélemények is forrásjelölt tételként, nem „social proof falként”. */}
          <div class="mt-10">
            {testimonials.map((t) => (
              <div class="border-t border-whisper py-6">
                <p class="text-[15px] text-creamSoft leading-[1.75] max-w-[60ch]">„{t.text}”</p>
                <p class="mt-3 text-[11px] uppercase tracking-caps text-creamMute">{t.name} · {t.service} · Google</p>
              </div>
            ))}
          </div>
          <a href={config.googleReviewsUrl} target="_blank" rel="noopener" class="mt-6 inline-flex items-center text-[12px] uppercase tracking-caps font-medium text-cream group hover:text-gold transition-colors">Mind a 60+ értékelés a Google-on<span aria-hidden class="ml-2 transition-transform duration-300 ease-out group-hover:translate-x-1">→</span></a>
        </Reveal>
        <Reveal client:visible as="div" className="lg:col-span-5" delay={0.1}>
          <figure class="ring-1 ring-white/10 bg-inkRise overflow-hidden">
            <img src={images.portrait} alt="Pecze-Kovács Fruzsina kozmetikus a FRUBEAUTY zuglói szalonjában" width="1200" height="1864" loading="lazy" decoding="async" class="w-full h-auto" />
            <figcaption class="px-5 py-3.5 text-[11px] uppercase tracking-caps text-creamMute border-t border-whisper">Pecze-Kovács Fruzsina — öt éve ugyanitt</figcaption>
          </figure>
        </Reveal>
      </div>
    </div>
  </section>

  {/* ── Próbafolt ──────────────────────────────────────────────────────────── */}
  <section class="py-20 sm:py-28 bg-inkSoft">
    <div class="max-w-[900px] mx-auto px-5 sm:px-8 lg:px-12">
      <Reveal client:visible as="div">
        <div class="border-2 border-gold/40 p-8 sm:p-12">
          <p class="text-[11px] uppercase tracking-caps text-gold mb-5">Az első lépés</p>
          <h2 class="font-display font-light leading-[1.1] tracking-tight text-cream" style="font-size: clamp(1.75rem, 3.6vw, 2.75rem);">Próbafolt és konzultáció — <em class="display">5 000 Ft</em>.</h2>
          <p class="mt-6 text-creamSoft leading-[1.75] max-w-[58ch]">Ez nem kezelés. Ez az a 25 perc, ami eldönti, van-e értelme a többinek. Az 5 000 Ft-ot beszámítom az első kezelés árába, és ha a szálad ősz, fehér vagy nagyon világos szőke, <span class="text-gold">itt fogom megmondani, hogy ne költs erre.</span></p>
          <div class="mt-9">
            <MagneticCTA href={config.booking} external variant="primary">Próbafoltot foglalok</MagneticCTA>
          </div>
          <BookingAssurance class="mt-6" offer="Lézer" />
        </div>
      </Reveal>
    </div>
  </section>

  {/* ── GYIK ───────────────────────────────────────────────────────────────── */}
  <section class="py-20 sm:py-28">
    <div class="max-w-[900px] mx-auto px-5 sm:px-8 lg:px-12">
      <Reveal client:visible as="div" className="mb-12">
        <p class="text-[11px] uppercase tracking-caps text-gold mb-5">Függelék</p>
        <h2 class="font-display font-light leading-[1.1] tracking-tight text-cream" style="font-size: clamp(1.75rem, 3.8vw, 2.75rem);">Amit a <em class="display">próbafolt előtt</em> érdemes tudni.</h2>
      </Reveal>
      <FAQList items={faqs} />
    </div>
  </section>

  {/* ── Kereszt ────────────────────────────────────────────────────────────── */}
  <section class="py-20 sm:py-28 bg-inkSoft">
    <div class="max-w-[1180px] mx-auto px-5 sm:px-8 lg:px-12">
      <Reveal client:visible as="div" className="mb-10 max-w-2xl">
        <h2 class="font-display font-light leading-[1.1] tracking-tight text-cream" style="font-size: clamp(1.75rem, 3.8vw, 2.75rem);">A lézer mellé, <em class="display">ugyanabban az időpontban</em>.</h2>
      </Reveal>
      <div class="grid sm:grid-cols-3 gap-x-10">
        {crossSell.map((s) => (
          <a href={s.href} class="group border-t border-whisperStrong pt-6 pb-4 block">
            <h3 class="font-display text-xl font-medium text-cream leading-snug">{s.title}</h3>
            <p class="mt-3 text-sm text-creamSoft leading-[1.7]">{s.body}</p>
            <p class="mt-5 font-display text-2xl text-cream tabular-nums">{s.price}</p>
            <span class="mt-4 inline-flex items-center text-[12px] uppercase tracking-caps font-medium text-creamMute group-hover:text-gold transition-colors">Részletek<span aria-hidden class="ml-2 transition-transform duration-300 ease-out group-hover:translate-x-1">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <SiteContact
    eyebrow="Foglalás"
    heading="Kezdjük egy <em class='display'>próbafolttal</em>."
    intro="Huszonöt perc, 5 000 Ft, és beszámítom az első kezelés árába. Utána már tudni fogod, mennyi alkalom kell, mennyibe kerül, és hogy egyáltalán érdemes-e nekivágnod."
    offer="Lézer"
  />
  <SiteFooter />
  <StickyBookBar eyebrow="Próbafolt és konzultáció · ~25 perc" price="5 000 Ft" cta="Foglalok" />
  <CookieBanner client:idle />
</Layout>

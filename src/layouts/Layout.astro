---
import { siteConfig, openingHoursSchema, analytics } from '../config/site';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title = 'FRUBEAUTY — Kozmetika és smink Zuglóban | Pecze-Kovács Fruzsina',
  description = `Pihentető arckezelés Janssen hatóanyagokkal, természetes szempilla-lift, szemöldök-laminálás és személyre szabott smink. Bejelentkezés online, ${siteConfig.postalCode} Budapest, ${siteConfig.streetAddress}`,
  image = '/og-image.jpg',
  canonical = Astro.url.href,
} = Astro.props;

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'BeautySalon',
  name: 'FRUBEAUTY',
  image: 'https://frubeauty.com/og-image.jpg',
  '@id': 'https://frubeauty.com',
  url: 'https://frubeauty.com',
  telephone: siteConfig.phone,
  email: siteConfig.email,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.streetAddress,
    addressLocality: siteConfig.locality,
    postalCode: siteConfig.postalCode,
    addressCountry: siteConfig.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: siteConfig.geo.latitude,
    longitude: siteConfig.geo.longitude,
  },
  openingHoursSpecification: openingHoursSchema.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.dayOfWeek,
    opens: h.opens,
    closes: h.closes,
  })),
  sameAs: [siteConfig.instagram, siteConfig.facebook],
};

const hasGA4 = analytics.ga4Id && analytics.ga4Id.length > 0;
const hasPixel = analytics.metaPixelId && analytics.metaPixelId.length > 0;
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#1A1410" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" as="image" href="/media/hero-poster.webp" type="image/webp" fetchpriority="high" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-latin-ext-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-latin-normal.woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Pecze-Kovács Fruzsina" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="hu_HU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    {hasGA4 && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${analytics.ga4Id}`}></script>
        <script is:inline define:vars={{ ga4Id: analytics.ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ window.dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', ga4Id, { send_page_view: true });
        </script>
      </>
    )}
    {hasPixel && (
      <script is:inline define:vars={{ pixelId: analytics.metaPixelId }}>
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId);
        fbq('track', 'PageView');
      </script>
    )}
  </head>
  <body class="bg-ink text-creamSoft font-body antialiased selection:bg-gold selection:text-ink">
    <slot />
    <script is:inline>
      (function () {
        var BOOKING_HOST = 'notino.hu';
        function pathSegment() {
          var p = (location.pathname || '/').replace(/^\/+|\/+$/g, '');
          return p === '' ? 'home' : p.split('/')[0].replace(/[^a-z0-9-_]/gi, '-').toLowerCase();
        }
        function addUtm(href, segment) {
          try {
            var u = new URL(href, location.origin);
            if (u.host.indexOf(BOOKING_HOST) === -1) return href;
            if (!u.searchParams.has('utm_source'))   u.searchParams.set('utm_source', 'site');
            if (!u.searchParams.has('utm_medium'))   u.searchParams.set('utm_medium', 'cta');
            if (!u.searchParams.has('utm_campaign')) u.searchParams.set('utm_campaign', segment);
            return u.toString();
          } catch (e) { return href; }
        }
        function decorate() {
          var seg = pathSegment();
          var links = document.querySelectorAll('a[href*="' + BOOKING_HOST + '"]');
          links.forEach(function (a) {
            var orig = a.getAttribute('href');
            if (!orig) return;
            a.setAttribute('href', addUtm(orig, seg));
            a.setAttribute('data-book-cta', '1');
          });
        }
        function fireEvents() {
          try { if (window.gtag) window.gtag('event', 'book_click', { event_category: 'cta', event_label: pathSegment() }); } catch (e) {}
          try { if (window.fbq) window.fbq('track', 'InitiateCheckout'); } catch (e) {}
        }
        decorate();
        document.addEventListener('DOMContentLoaded', decorate);
        document.addEventListener('click', function (ev) {
          var t = ev.target instanceof Element ? ev.target.closest('a[data-book-cta]') : null;
          if (!t) return;
          fireEvents();
        }, true);
        new MutationObserver(function () { decorate(); })
          .observe(document.body, { childList: true, subtree: true });
      })();
    </script>

    <style is:global>
      @font-face {
        font-family: 'Fraunces';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/fraunces-latin-ext-normal.woff2') format('woff2');
        unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;
      }
      @font-face {
        font-family: 'Fraunces';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/fraunces-latin-normal.woff2') format('woff2');
        unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
      }
      @font-face {
        font-family: 'Fraunces';
        font-style: italic;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/fraunces-latin-ext-italic.woff2') format('woff2');
        unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;
      }
      @font-face {
        font-family: 'Fraunces';
        font-style: italic;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/fraunces-latin-italic.woff2') format('woff2');
        unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
      }
      @font-face {
        font-family: 'Geist';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/geist-400.woff2') format('woff2');
        unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
      }
      @font-face {
        font-family: 'Geist';
        font-style: normal;
        font-weight: 500;
        font-display: swap;
        src: url('/fonts/geist-500.woff2') format('woff2');
        unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
      }
      @font-face {
        font-family: 'Geist';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/geist-600.woff2') format('woff2');
        unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
      }

      :root {
        --ease-out-strong:    cubic-bezier(0.23, 1, 0.32, 1);
        --ease-in-out-strong: cubic-bezier(0.77, 0, 0.175, 1);
        --ease-drawer:        cubic-bezier(0.32, 0.72, 0, 1);
      }

      .font-display {
        font-feature-settings: 'ss01', 'ss02';
        font-variation-settings: 'SOFT' 30, 'opsz' 144;
      }

      .font-display em, em.display {
        font-style: italic;
        font-variation-settings: 'SOFT' 50, 'opsz' 144;
        color: var(--gold, #B8884A);
      }

      body {
        font-size: 16px;
        line-height: 1.65;
        font-feature-settings: 'kern', 'liga', 'calt';
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      @media (min-width: 768px) { body { font-size: 17px; } }
      p { line-height: 1.7; }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 100px;
        background: #1A1410;
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }

      :where(a, button):focus-visible {
        outline: 2px solid rgba(184, 136, 74, 0.55);
        outline-offset: 3px;
        border-radius: 6px;
      }

      @keyframes heroFadeUp {
        from { opacity: 0; transform: translateY(12px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      .hero-reveal {
        animation: heroFadeUp 0.65s cubic-bezier(0.23, 1, 0.32, 1) both;
      }
      @media (prefers-reduced-motion: reduce) {
        .hero-reveal { animation: none; opacity: 1; }
      }

      @keyframes zeroJsFade {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      .zero-js-fade {
        animation: zeroJsFade 0.5s cubic-bezier(0.23, 1, 0.32, 1) 0.15s both;
      }
      @media (prefers-reduced-motion: reduce) {
        .zero-js-fade { animation: none; opacity: 1; }
      }
    </style>
  </body>
</html>

---
import { siteConfig, openingHoursSchema, analytics } from '../config/site';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  /** null removes canonical entirely (for example on the 404 page). */
  canonical?: string | null;
  robots?: string;
  /** False on utility/error pages that should not emit the global entity graph. */
  includeBusinessSchema?: boolean;
  /** Above-the-fold LCP image to preload. Pass undefined on text-led pages so
      we don't waste mobile bandwidth preloading an image that isn't the LCP. */
  preloadImage?: string;
  /** Extra JSON-LD schema objects (FAQPage, Service stb.) az adott aloldalhoz.
      A Layout a <head>-ben rendereli őket a globális businessSchema után. */
  additionalSchemas?: object[];
  /** OG-tartalomtípus. Blogcikken 'article' (publikálási/módosítási dátummal),
      minden más oldalon marad a 'website'. Az Ahrefs-audit (2026-07-31) mind a
      23 oldalon 'website'-ot talált — a cikkeken ez rossz típusjelzést ad a
      közösségi előnézeteknek és az AI-crawlereknek. */
  ogType?: 'website' | 'article';
  /** ISO dátum az article:published_time-hoz (csak ogType='article' esetén). */
  publishedTime?: string;
  /** ISO dátum az article:modified_time-hoz (csak ogType='article' esetén). */
  modifiedTime?: string;
}

const {
  title = 'Kozmetika és smink Zuglóban — FRUBEAUTY | Pecze-Kovács',
  description = `Arckezelés Janssen hatóanyagokkal, szempilla-lift, szemöldök-laminálás és személyre szabott smink Zuglóban. Online foglalás — ${siteConfig.postalCode} Budapest, ${siteConfig.streetAddress}`,
  image = '/og-image.jpg',
  imageAlt = title,
  canonical = Astro.url.href,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  includeBusinessSchema = true,
  preloadImage,
  additionalSchemas = [],
  ogType = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;

// OG/Twitter image-nek abszolút URL kell — Facebook és Twitter nem követi a
// relatív útvonalakat. Ha az image már http/https-sel kezdődik, marad úgy.
const absoluteOgImage = image.startsWith('http')
  ? image
  : `https://frubeauty.com${image}`;

// @graph: összefüggő entitás-gráf (BeautySalon + Person + WebSite) —
// a különálló objektumok @id-vel hivatkoznak egymásra, így az AI-keresők
// és a Google Knowledge Graph egységes entitásként látják a szalont és Fruzsinát.
const businessSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BeautySalon',
      '@id': 'https://frubeauty.com/#business',
      name: 'FRUBEAUTY – Pecze-Kovács Fruzsina Kozmetikus',
      url: 'https://frubeauty.com',
      image: ['https://frubeauty.com/og-image.jpg'],
      telephone: siteConfig.phone,
      email: siteConfig.email,
      priceRange: '4000–49500 Ft',
      currenciesAccepted: 'HUF',
      paymentAccepted: 'Készpénz, Bankkártya',
      address: {
        '@type': 'PostalAddress',
        streetAddress: siteConfig.streetAddress,
        addressLocality: siteConfig.locality,
        addressRegion: 'Zugló (XIV. kerület)',
        postalCode: siteConfig.postalCode,
        addressCountry: siteConfig.country,
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: siteConfig.geo.latitude,
        longitude: siteConfig.geo.longitude,
      },
      hasMap: siteConfig.mapsUrl,
      founder: { '@id': 'https://frubeauty.com/#fruzsina' },
      employee: { '@id': 'https://frubeauty.com/#fruzsina' },
      openingHoursSpecification: openingHoursSchema.map((h) => ({
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: h.dayOfWeek,
        opens: h.opens,
        closes: h.closes,
      })),
      // AggregateRating SZÁNDÉKOSAN eltávolítva: a saját domainen elhelyezett,
      // önmagunkról szóló (self-serving) értékelés-jelölés LocalBusiness-nél nem ad
      // csillagos rich resultot, és strukturált-adat manual action kockázata van.
      // A csillagokat a Google Business Profile hozza a Mapsen/lokális találatban
      // és az Ads helybővítményben — arra támaszkodunk.
      areaServed: [
        { '@type': 'AdministrativeArea', name: 'Zugló (XIV. kerület)' },
        { '@type': 'City', name: 'Budapest' },
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'FRUBEAUTY szépségszalon szolgáltatások',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: { '@type': 'Service', name: 'Szempilla lifting + festés', url: 'https://frubeauty.com/szempilla-lifting-zuglo/' },
            price: '12000',
            priceCurrency: 'HUF',
          },
          {
            '@type': 'Offer',
            itemOffered: { '@type': 'Service', name: 'Szemöldök laminálás + formázás', url: 'https://frubeauty.com/szemoldok-laminalas-zuglo/' },
            price: '11000',
            priceCurrency: 'HUF',
          },
          {
            // Ár = a money-page-en marketingelt „-tól" arckezelés-ár (SOS Sensitive),
            // NEM a 11 000 Ft-os Relax & Glow masszázs add-on, hogy ne adjunk
            // félrevezetően alacsony „arckezelés-tól" jelet az entitás-gráfban.
            '@type': 'Offer',
            itemOffered: { '@type': 'Service', name: 'Janssen arckezelés', url: 'https://frubeauty.com/arckezeles-zuglo/' },
            price: '16900',
            priceCurrency: 'HUF',
          },
          {
            '@type': 'Offer',
            itemOffered: { '@type': 'Service', name: 'Alkalmi és esküvői smink', url: 'https://frubeauty.com/sminkes-zuglo/' },
            price: '13000',
            priceCurrency: 'HUF',
          },
        ],
      },
      sameAs: [
        siteConfig.instagram,
        siteConfig.facebook,
        'https://www.notino.hu/szalonok/pecze-kovacs-fruzsina-sminkes,-szemoldok-es-szempilla-stylist',
      ],
    },
    {
      '@type': 'Person',
      '@id': 'https://frubeauty.com/#fruzsina',
      url: 'https://frubeauty.com/rolam/',
      mainEntityOfPage: 'https://frubeauty.com/rolam/',
      name: 'Pecze-Kovács Fruzsina',
      jobTitle: 'Kozmetikus, szempilla- és szemöldök-stylist',
      image: 'https://frubeauty.com/img/fruzsina-portrait.jpg',
      worksFor: { '@id': 'https://frubeauty.com/#business' },
      knowsAbout: [
        'szempilla lifting',
        'szemöldök laminálás',
        'koreai lash lift',
        'Janssen arckezelés',
        'alkalmi smink',
      ],
      sameAs: [siteConfig.instagram, siteConfig.facebook],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://frubeauty.com/#website',
      url: 'https://frubeauty.com',
      name: 'FRUBEAUTY',
      publisher: { '@id': 'https://frubeauty.com/#business' },
      inLanguage: 'hu-HU',
    },
  ],
};

const hasGA4 = analytics.ga4Id && analytics.ga4Id.length > 0;
const hasGoogleTag = analytics.googleTagId && analytics.googleTagId.length > 0;
const hasPixel = analytics.metaPixelId && analytics.metaPixelId.length > 0;
const hasGoogleAds = analytics.googleAdsId && analytics.googleAdsId.length > 0;
// A gtag.js LOADER ID-je. FONTOS: az egyesített Google-tagnél (GT-…) a GA4 (G-)
// és az Ads (AW-) is csak DESTINATION — a 'G-…' ID-ra a googletagmanager.com
// 404-et ad, ami némán megöli a teljes mérést. Ezért a loader a GT- ID-t kapja,
// és külön config-oljuk a GA4 + Ads destinationöket. Sorrend: GT- > AW- > G-.
const primaryGtagId = hasGoogleTag
  ? analytics.googleTagId
  : (hasGoogleAds ? analytics.googleAdsId : (hasGA4 ? analytics.ga4Id : ''));
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#1A1410" />
    {canonical && <link rel="canonical" href={canonical} />}
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} type={preloadImage.endsWith('.avif') ? 'image/avif' : 'image/webp'} fetchpriority="high" />
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content="Pecze-Kovács Fruzsina" />
    <meta property="og:type" content={ogType} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === 'article' && <meta property="article:author" content="Pecze-Kovács Fruzsina" />}
    <meta property="og:locale" content="hu_HU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:alt" content={imageAlt} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {includeBusinessSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    )}
    {additionalSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    {primaryGtagId && (
      <script is:inline define:vars={{
        ga4Id: analytics.ga4Id,
        googleAdsId: analytics.googleAdsId,
        hasGA4,
        hasGoogleAds,
        primaryGtagId,
      }}>
        // A gtag stub azonnal definiálódik, így a config + a konverziós események
        // queue-olnak a dataLayer-be. A nehéz gtag.js letöltést viszont leszedjük a
        // kritikus útvonalról (mobil PSI) — első interakcióra vagy idle-re töltjük be.
        window.dataLayer = window.dataLayer || [];
        function gtag(){ window.dataLayer.push(arguments); }
        window.gtag = gtag;

        // --- Google Consent Mode V2 ---
        // GDPR opt-in: alapból MINDEN hirdetési és analitikai tárolás TILTOTT, amíg a
        // látogató a cookie bannerben rá nem bólint. Consent-jelzés nélkül a Google Tag
        // EU-ban visszatartja az adatküldést → 0 mért forgalom és konverzió. A 'default'
        // parancsnak a gtag config / gtag.js letöltése ELŐTT kell lefutnia, ezért áll itt.
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          wait_for_update: 500
        });
        // Visszatérő látogató, aki KORÁBBAN elfogadta: a banner nem jelenik meg újra,
        // ezért a tárolt döntést betöltéskor itt azonnal érvényesítjük (különben
        // 'denied'-en ragadna). Az élő bannerre-kattintás a lenti listeneren át jön.
        try {
          if (window.localStorage.getItem('frubeauty_cookie_consent_v1') === 'all') {
            gtag('consent', 'update', {
              ad_storage: 'granted',
              ad_user_data: 'granted',
              ad_personalization: 'granted',
              analytics_storage: 'granted'
            });
          }
        } catch (e) {}
        // A CookieBanner (React) a döntéskor 'cookie-consent' eseményt szór ('all' |
        // 'essential'); itt kötjük rá a Consent Mode update-et, így minden gtag-hívás
        // egy helyen, a stub mellett marad. 'essential' → marad a denied.
        window.addEventListener('cookie-consent', function (ev) {
          var granted = ev && ev.detail === 'all';
          gtag('consent', 'update', {
            ad_storage: granted ? 'granted' : 'denied',
            ad_user_data: granted ? 'granted' : 'denied',
            ad_personalization: granted ? 'granted' : 'denied',
            analytics_storage: granted ? 'granted' : 'denied'
          });
        });

        gtag('js', new Date());
        if (hasGA4)       gtag('config', ga4Id, { send_page_view: true });
        if (hasGoogleAds) gtag('config', googleAdsId);

        // gtag.js EAGER (azonnali) async betöltése. A korábbi "csak az első
        // interakcióra töltünk" lazy hack ELRONTOTTA az Ads-konverziókat: a
        // látogató első interakciója gyakran MAGA a CTA-kattintás. Ekkor a
        // window.gtag még csak a stub → a 'conversion' event a dataLayer queue-ba
        // kerül, a böngésző AZONNAL elnavigál a Notino-ra, a gtag.js pedig egy már
        // elhagyott oldalon töltene be → a konverzió sosem megy ki. Az async
        // betöltés nem blokkolja a renderelést (nincs érdemi LCP/TBT-hatás egy
        // statikus oldalon), viszont a kattintásig a gtag.js szinte biztosan kész,
        // és a konverzió sendBeacon-nel, navigáció ELŐTT kimegy. A konverziómérés
        // megbízhatósága fontosabb, mint pár ms szintetikus PSI-pont.
        (function () {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + primaryGtagId;
          document.head.appendChild(s);
        })();
      </script>
    )}
    {hasPixel && (
      <script is:inline define:vars={{ pixelId: analytics.metaPixelId }}>
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId);
        fbq('track', 'PageView');
      </script>
    )}
  </head>
  <body class="bg-ink text-creamSoft font-body antialiased selection:bg-gold selection:text-ink">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:top-3 focus:left-3 focus:px-4 focus:py-2 focus:rounded-full focus:bg-gold focus:text-ink focus:text-sm focus:font-medium"
    >
      Ugrás a tartalomra
    </a>
    <main id="main-content" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <script is:inline>
      (function () {
        var BOOKING_HOST = 'notino.hu';
        // Google Ads konverziós azonosítók. A telefonhívás (tel: katt) jelenleg
        // UGYANARRA az "Időpontfoglalás" konverzióra fut, mint az online foglalás.
        // Ha külön hívás-konverziós akciót hozol létre a Google Ads-ben, csak
        // cseréld le a CALL_SEND_TO értékét az új címkére (AW-17992123771/ÚJ_LABEL).
        var BOOK_SEND_TO = 'AW-17992123771/LHaBCP_fj6McEPuKqIND';
        var CALL_SEND_TO = 'AW-17992123771/LHaBCP_fj6McEPuKqIND';
        var CONVERSION_VALUE = 12500.0;
        function pathSegment() {
          var p = (location.pathname || '/').replace(/^\/+|\/+$/g, '');
          return p === '' ? 'home' : p.split('/')[0].replace(/[^a-z0-9-_]/gi, '-').toLowerCase();
        }
        function addUtm(href, segment) {
          try {
            var u = new URL(href, location.origin);
            if (u.host.indexOf(BOOKING_HOST) === -1) return href;
            if (!u.searchParams.has('utm_source'))   u.searchParams.set('utm_source', 'site');
            if (!u.searchParams.has('utm_medium'))   u.searchParams.set('utm_medium', 'cta');
            if (!u.searchParams.has('utm_campaign')) u.searchParams.set('utm_campaign', segment);
            return u.toString();
          } catch (e) { return href; }
        }
        function decorate() {
          var seg = pathSegment();
          var links = document.querySelectorAll('a[href*="' + BOOKING_HOST + '"]');
          links.forEach(function (a) {
            var orig = a.getAttribute('href');
            if (!orig) return;
            a.setAttribute('href', addUtm(orig, seg));
            a.setAttribute('data-book-cta', '1');
          });
        }
        function fireAdsConversion(sendTo) {
          try {
            if (window.gtag) {
              window.gtag('event', 'conversion', {
                'send_to': sendTo,
                'value': CONVERSION_VALUE,
                'currency': 'HUF',
                'event_callback': function() {}
              });
            }
          } catch (e) {}
        }
        // Online foglalási szándék — Notino-linkre kattintás.
        function fireEvents() {
          try { if (window.gtag) window.gtag('event', 'book_click', { event_category: 'cta', event_label: pathSegment() }); } catch (e) {}
          try { if (window.fbq) window.fbq('track', 'InitiateCheckout'); } catch (e) {}
          fireAdsConversion(BOOK_SEND_TO);
        }
        // Telefonos foglalási szándék — tel: linkre kattintás (mobilon hívásindítás).
        function fireCallEvents() {
          try { if (window.gtag) window.gtag('event', 'call_click', { event_category: 'cta', event_label: pathSegment() }); } catch (e) {}
          try { if (window.fbq) window.fbq('track', 'Contact'); } catch (e) {}
          fireAdsConversion(CALL_SEND_TO);
        }
        // A konverzió-mérés közvetlenül a linkre köt (capture fázis) — független a
        // decorate() futásától, így mindig tűz, akkor is, ha a linket egy React
        // sziget hidratálta be. Notino-link → online foglalás; tel: → telefonos
        // foglalási szándék.
        document.addEventListener('click', function (ev) {
          if (!(ev.target instanceof Element)) return;
          if (ev.target.closest('a[href*="' + BOOKING_HOST + '"]')) { fireEvents(); return; }
          if (ev.target.closest('a[href^="tel:"]')) { fireCallEvents(); return; }
        }, true);

        // decorate() bounded futtatása — NINCS perzisztens MutationObserver, ami
        // minden DOM-mutációnál teljes querySelectorAll-t (forced reflow) hajtana
        // végre a szigetek hidratálása közben. A statikus linkeket azonnal, a
        // szigetekbe renderelteket pedig a hidratálás lecsengése után dekoráljuk.
        decorate();
        document.addEventListener('DOMContentLoaded', decorate);
        window.addEventListener('load', decorate);
        if (window.requestIdleCallback) window.requestIdleCallback(decorate, { timeout: 2500 });
        else window.setTimeout(decorate, 1800);
      })();
    </script>

    <script is:inline>
      /* --- Fejlécmagasság FESTÉS ELŐTT ---------------------------------------
         Az AnnouncementBar futásidőben jelenik meg (client:idle/​load sziget) és
         ~54 px-et ad a fix fejléchez. A hero padding-ja eddig beégetett érték
         volt (pt-44/pt-52), ezért a fejléc alatti optikai rés 143 px-ről 89-re
         ugrott, amint a sáv megjelent — ez volt az elcsúszás.

         A sáv megjelenésének feltétele tisztán localStorage-ból eldönthető
         (mai Notino-kattintás száma ≥ 1 ÉS nincs elvetve), amit itt, a <head>-ben
         SZINKRONBAN kiolvasunk. Így a hero már az ELSŐ layoutnál a helyes
         paddinget kapja → a sáv utólagos beanimálása NEM okoz layout shiftet
         (0 CLS), a fejléc alatti rés pedig mindkét állapotban ugyanaz.
         A kulcsoknak egyezniük kell az AnnouncementBar.tsx-beliekkel. */
      (function () {
        try {
          var d = new Date();
          var key = 'frubeauty_booking_clicks_' + d.getFullYear() + '-' +
            String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
          var clicks = parseInt(window.localStorage.getItem(key) || '0', 10);
          var dismissed = window.localStorage.getItem('frubeauty_promo_dismissed_v5');
          if (clicks >= 1 && !dismissed) document.documentElement.dataset.announcement = 'on';
        } catch (e) {}
      })();

      /* Utólagos korrekció: ha a fejléc a becsülttől eltérő magasságú lesz
         (pl. a sáv szövege két sorba tördel, vagy a user elveti a sávot), a
         valós magasság kerül a változóba. Debounce-olva, hogy a sáv 400 ms-os
         nyitó animációjának KÖZTES értékei ne kerüljenek bele — különben a hero
         együtt csúszna az animációval. */
      (function () {
        var root = document.documentElement, t;
        function init() {
          var el = document.querySelector('.fixed.top-0');
          if (!el || !window.ResizeObserver) return;
          new ResizeObserver(function () {
            clearTimeout(t);
            t = setTimeout(function () {
              var h = el.getBoundingClientRect().height;
              if (h > 0) root.style.setProperty('--header-h', h + 'px');
            }, 150);
          }).observe(el);
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
        else init();
      })();

      /* --- Betűk EGY hullámban ------------------------------------------------
         Mérve a betűfájlok két hullámban érkeztek, ~900 ms különbséggel:
           1. hullám  634–713 ms: geist-400/500, fraunces-latin(+italic), latin-ext-italic
           2. hullám 1524–1550 ms: geist-600 ÉS fraunces-latin-ext-normal
         A második hullámban van a NORMÁL súlyú ő/ű (fraunces-latin-ext) — ezért
         villant fel másodszor is a szöveg, jóval az első csere után.

         A késés oka, hogy ezek a glyphek csak lejjebb, a content-visibility:auto
         szekciókban fordulnak elő, így a böngésző csak ott fedezi fel őket.
         A Font Loading API-val előre kérjük őket, de CSAK az LCP megfestése UTÁN,
         tehát a kritikus útból semmit nem veszünk el — a preload-mentes stratégia
         és az LCP-kép sávszélessége érintetlen marad. A szöveg-hint (őűŐŰ) miatt
         csak a tényleg szükséges unicode-range subsetek töltenek. */
      (function () {
        if (!document.fonts || !document.fonts.load) return;
        var done = false;
        var HU = 'őűŐŰ';
        function warm() {
          if (done) return;
          done = true;
          var specs = [
            ['300 1rem Fraunces', HU], ['400 1rem Fraunces', HU], ['500 1rem Fraunces', HU],
            ['italic 300 1rem Fraunces', HU],
            ['400 1rem Geist', HU], ['500 1rem Geist', HU], ['600 1rem Geist', 'a' + HU]
          ];
          for (var i = 0; i < specs.length; i++) {
            try { document.fonts.load(specs[i][0], specs[i][1]); } catch (e) {}
          }
        }
        if (window.PerformanceObserver) {
          try {
            var po = new PerformanceObserver(function () { warm(); po.disconnect(); });
            po.observe({ type: 'largest-contentful-paint', buffered: true });
          } catch (e) {}
        }
        window.addEventListener('load', warm, { once: true });
      })();
    </script>

    <style is:global>
      /* ===== Metrika-illesztett tartalék fontok =====================
         A korábbi kalibráció capsize-zal készült, ami a FÜGGŐLEGES metrikákat
         (ascent/descent/cap height) illeszti — a betűSZÉLESSÉGET nem. Mérve
         viszont pont a szélesség tért el drasztikusan, és a látható „felvillanás"
         is ebből jött:

           Fraunces opsz 144, 72 px, ugyanaz a hero-sor
             valódi Fraunces ............ 1378,6 px
             régi tartalék (Georgia) .... 2006,0 px   → +45,5%

         Ezért a tartalékokat mostantól SZÉLESSÉGRE kalibráljuk, a függőleges
         dobozt pedig az ascent/descent-override skálázásával tartjuk változatlanul
         (effektív ascent = override × size-adjust — a szorzat ugyanaz maradt,
         tehát a sormagasság és a CLS-viselkedés nem változik).

         Két tartalék kell, mert a két optikai regiszter metrikája gyökeresen más:
           • display (h1/h2, opsz 144): erősen sűrített, kontrasztos vágat →
             a Times New Roman áll hozzá a legközelebb (1,131× a Georgia 1,252×
             helyett), és vékonyabb is, tehát a „vastag felvillanás" is megszűnik.
           • text (minden más .font-display, opsz auto): itt a Georgia a legjobb
             (0,938×).
         Mért arányok stabilak a méretskálán (display 1,4549–1,4551 32→72 px
         között), tehát egyetlen size-adjust minden fokozatra jó. */
      @font-face {
        font-family: 'Fraunces Display Fallback';
        src: local('Times New Roman'), local('Georgia');
        size-adjust: 88.4%;
        ascent-override: 110.64%;
        descent-override: 28.85%;
        line-gap-override: 0%;
      }
      @font-face {
        font-family: 'Fraunces Fallback';
        src: local('Georgia'), local('Times New Roman');

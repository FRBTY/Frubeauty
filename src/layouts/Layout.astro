---
import { siteConfig, openingHoursSchema, analytics } from '../config/site';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  /** Above-the-fold LCP image to preload. Pass undefined on text-led pages so
      we don't waste mobile bandwidth preloading an image that isn't the LCP. */
  preloadImage?: string;
  /** Extra JSON-LD schema objects (FAQPage, Service stb.) az adott aloldalhoz.
      A Layout a <head>-ben rendereli őket a globális businessSchema után. */
  additionalSchemas?: object[];
}

const {
  title = 'Kozmetika és smink Zuglóban — FRUBEAUTY | Pecze-Kovács',
  description = `Arckezelés Janssen hatóanyagokkal, szempilla-lift, szemöldök-laminálás és személyre szabott smink Zuglóban. Online foglalás — ${siteConfig.postalCode} Budapest, ${siteConfig.streetAddress}`,
  image = '/og-image.jpg',
  canonical = Astro.url.href,
  preloadImage,
  additionalSchemas = [],
} = Astro.props;

// OG/Twitter image-nek abszolút URL kell — Facebook és Twitter nem követi a
// relatív útvonalakat. Ha az image már http/https-sel kezdődik, marad úgy.
const absoluteOgImage = image.startsWith('http')
  ? image
  : `https://frubeauty.com${image}`;

// @graph: összefüggő entitás-gráf (BeautySalon + Person + WebSite) —
// a különálló objektumok @id-vel hivatkoznak egymásra, így az AI-keresők
// és a Google Knowledge Graph egységes entitásként látják a szalont és Fruzsinát.
const businessSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BeautySalon',
      '@id': 'https://frubeauty.com/#business',
      name: 'FRUBEAUTY – Pecze-Kovács Fruzsina',
      url: 'https://frubeauty.com',
      image: ['https://frubeauty.com/og-image.jpg'],
      telephone: siteConfig.phone,
      email: siteConfig.email,
      priceRange: '4000–26000 Ft',
      currenciesAccepted: 'HUF',
      paymentAccepted: 'Készpénz, Bankkártya',
      address: {
        '@type': 'PostalAddress',
        streetAddress: siteConfig.streetAddress,
        addressLocality: siteConfig.locality,
        addressRegion: 'Zugló (XIV. kerület)',
        postalCode: siteConfig.postalCode,
        addressCountry: siteConfig.country,
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: siteConfig.geo.latitude,
        longitude: siteConfig.geo.longitude,
      },
      hasMap: siteConfig.mapsUrl,
      founder: { '@id': 'https://frubeauty.com/#fruzsina' },
      employee: { '@id': 'https://frubeauty.com/#fruzsina' },
      openingHoursSpecification: openingHoursSchema.map((h) => ({
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: h.dayOfWeek,
        opens: h.opens,
        closes: h.closes,
      })),
      // AggregateRating SZÁNDÉKOSAN eltávolítva: a saját domainen elhelyezett,
      // önmagunkról szóló (self-serving) értékelés-jelölés LocalBusiness-nél nem ad
      // csillagos rich resultot, és strukturált-adat manual action kockázata van.
      // A csillagokat a Google Business Profile hozza a Mapsen/lokális találatban
      // és az Ads helybővítményben — arra támaszkodunk.
      areaServed: [
        { '@type': 'AdministrativeArea', name: 'Zugló (XIV. kerület)' },
        { '@type': 'City', name: 'Budapest' },
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Szempilla és szemöldök kezelések',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: { '@type': 'Service', name: 'Szempilla lifting + festés', url: 'https://frubeauty.com/szempilla-lifting-zuglo' },
            price: '12000',
            priceCurrency: 'HUF',
          },
          {
            '@type': 'Offer',
            itemOffered: { '@type': 'Service', name: 'Szemöldök laminálás + formázás', url: 'https://frubeauty.com/szemoldok-laminalas-zuglo' },
            price: '11000',
            priceCurrency: 'HUF',
          },
        ],
      },
      sameAs: [
        siteConfig.instagram,
        siteConfig.facebook,
        'https://www.notino.hu/szalonok/pecze-kovacs-fruzsina-sminkes,-szemoldok-es-szempilla-stylist',
      ],
    },
    {
      '@type': 'Person',
      '@id': 'https://frubeauty.com/#fruzsina',
      name: 'Pecze-Kovács Fruzsina',
      jobTitle: 'Kozmetikus, szempilla- és szemöldök-stylist',
      image: 'https://frubeauty.com/img/fruzsina-portrait.jpg',
      worksFor: { '@id': 'https://frubeauty.com/#business' },
      knowsAbout: [
        'szempilla lifting',
        'szemöldök laminálás',
        'koreai lash lift',
        'Janssen arckezelés',
        'alkalmi smink',
      ],
      hasCredential: {
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'Kozmetikus szakképesítés',
        name: 'Koreai lash lift technika',
      },
      sameAs: [siteConfig.instagram, siteConfig.facebook],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://frubeauty.com/#website',
      url: 'https://frubeauty.com',
      name: 'FRUBEAUTY',
      publisher: { '@id': 'https://frubeauty.com/#business' },
      inLanguage: 'hu-HU',
    },
  ],
};

const hasGA4 = analytics.ga4Id && analytics.ga4Id.length > 0;
const hasPixel = analytics.metaPixelId && analytics.metaPixelId.length > 0;
const hasGoogleAds = analytics.googleAdsId && analytics.googleAdsId.length > 0;
// Az elsődleges gtag script forrása: ha GA4 van, azt töltjük be (és aztán config-oljuk az Ads-t is);
// ha csak Ads van, akkor az Ads ID-t használjuk loader ID-ként.
const primaryGtagId = hasGA4 ? analytics.ga4Id : (hasGoogleAds ? analytics.googleAdsId : '');
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#1A1410" />
    <link rel="canonical" href={canonical} />
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} type="image/webp" fetchpriority="high" />
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Pecze-Kovács Fruzsina" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="hu_HU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    {additionalSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    {primaryGtagId && (
      <script is:inline define:vars={{
        ga4Id: analytics.ga4Id,
        googleAdsId: analytics.googleAdsId,
        hasGA4,
        hasGoogleAds,
        primaryGtagId,
      }}>
        // A gtag stub azonnal definiálódik, így a config + a konverziós események
        // queue-olnak a dataLayer-be. A nehéz gtag.js letöltést viszont leszedjük a
        // kritikus útvonalról (mobil PSI) — első interakcióra vagy idle-re töltjük be.
        window.dataLayer = window.dataLayer || [];
        function gtag(){ window.dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        if (hasGA4)       gtag('config', ga4Id, { send_page_view: true });
        if (hasGoogleAds) gtag('config', googleAdsId);

        // A nehéz gtag.js letöltést az első valódi felhasználói interakcióhoz
        // kötjük (scroll/tap/billentyű) — így a kód NEM kerül a kritikus betöltési
        // ablakba (mobil PSI: nincs third-party parse a mért TBT-ben). Valódi
        // látogató mindig interaktál (legalább görget) → követés és konverzió-
        // mérés továbbra is működik (a stub queue-olja a parancsokat addig is).
        var gtagLoaded = false;
        var opts = { once: true, passive: true, capture: true };
        var events = ['pointerdown', 'mousemove', 'touchstart', 'keydown', 'scroll', 'wheel'];
        function loadGtag() {
          if (gtagLoaded) return;
          gtagLoaded = true;
          events.forEach(function (e) { window.removeEventListener(e, loadGtag, opts); });
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + primaryGtagId;
          document.head.appendChild(s);
        }
        events.forEach(function (e) { window.addEventListener(e, loadGtag, opts); });

        // Fallback a GA4-hez: interakció NÉLKÜLI látogatónál (no-interaction bounce)
        // is rögzüljön a session. A load esemény UTÁN, idle-ben töltünk — a kritikus
        // betöltési ablakon kívül, hogy a mobil PSI-t minimálisan érintse. Idempotens
        // (a gtagLoaded guard miatt sosem tölt kétszer; az interakció továbbra is
        // azonnal triggereli, ez csak biztonsági háló a némán távozókra).
        function idleLoadGtag() {
          if (window.requestIdleCallback) window.requestIdleCallback(loadGtag, { timeout: 4000 });
          else window.setTimeout(loadGtag, 3000);
        }
        if (document.readyState === 'complete') idleLoadGtag();
        else window.addEventListener('load', idleLoadGtag, { once: true });
      </script>
    )}
    {hasPixel && (
      <script is:inline define:vars={{ pixelId: analytics.metaPixelId }}>
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId);
        fbq('track', 'PageView');
      </script>
    )}
  </head>
  <body class="bg-ink text-creamSoft font-body antialiased selection:bg-gold selection:text-ink">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:top-3 focus:left-3 focus:px-4 focus:py-2 focus:rounded-full focus:bg-gold focus:text-ink focus:text-sm focus:font-medium"
    >
      Ugrás a tartalomra
    </a>
    <main id="main-content" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <script is:inline>
      (function () {
        var BOOKING_HOST = 'notino.hu';
        // Google Ads konverziós azonosítók. A telefonhívás (tel: katt) jelenleg
        // UGYANARRA az "Időpontfoglalás" konverzióra fut, mint az online foglalás.
        // Ha külön hívás-konverziós akciót hozol létre a Google Ads-ben, csak
        // cseréld le a CALL_SEND_TO értékét az új címkére (AW-17992123771/ÚJ_LABEL).
        var BOOK_SEND_TO = 'AW-17992123771/LHaBCP_fj6McEPuKqIND';
        var CALL_SEND_TO = 'AW-17992123771/LHaBCP_fj6McEPuKqIND';
        var CONVERSION_VALUE = 12500.0;
        function pathSegment() {
          var p = (location.pathname || '/').replace(/^\/+|\/+$/g, '');
          return p === '' ? 'home' : p.split('/')[0].replace(/[^a-z0-9-_]/gi, '-').toLowerCase();
        }
        function addUtm(href, segment) {
          try {
            var u = new URL(href, location.origin);
            if (u.host.indexOf(BOOKING_HOST) === -1) return href;
            if (!u.searchParams.has('utm_source'))   u.searchParams.set('utm_source', 'site');
            if (!u.searchParams.has('utm_medium'))   u.searchParams.set('utm_medium', 'cta');
            if (!u.searchParams.has('utm_campaign')) u.searchParams.set('utm_campaign', segment);
            return u.toString();
          } catch (e) { return href; }
        }
        function decorate() {
          var seg = pathSegment();
          var links = document.querySelectorAll('a[href*="' + BOOKING_HOST + '"]');
          links.forEach(function (a) {
            var orig = a.getAttribute('href');
            if (!orig) return;
            a.setAttribute('href', addUtm(orig, seg));
            a.setAttribute('data-book-cta', '1');
          });
        }
        function fireAdsConversion(sendTo) {
          try {
            if (window.gtag) {
              window.gtag('event', 'conversion', {
                'send_to': sendTo,
                'value': CONVERSION_VALUE,
                'currency': 'HUF',
                'event_callback': function() {}
              });
            }
          } catch (e) {}
        }
        // Online foglalási szándék — Notino-linkre kattintás.
        function fireEvents() {
          try { if (window.gtag) window.gtag('event', 'book_click', { event_category: 'cta', event_label: pathSegment() }); } catch (e) {}
          try { if (window.fbq) window.fbq('track', 'InitiateCheckout'); } catch (e) {}
          fireAdsConversion(BOOK_SEND_TO);
        }
        // Telefonos foglalási szándék — tel: linkre kattintás (mobilon hívásindítás).
        function fireCallEvents() {
          try { if (window.gtag) window.gtag('event', 'call_click', { event_category: 'cta', event_label: pathSegment() }); } catch (e) {}
          try { if (window.fbq) window.fbq('track', 'Contact'); } catch (e) {}
          fireAdsConversion(CALL_SEND_TO);
        }
        // A konverzió-mérés közvetlenül a linkre köt (capture fázis) — független a
        // decorate() futásától, így mindig tűz, akkor is, ha a linket egy React
        // sziget hidratálta be. Notino-link → online foglalás; tel: → telefonos
        // foglalási szándék.
        document.addEventListener('click', function (ev) {
          if (!(ev.target instanceof Element)) return;
          if (ev.target.closest('a[href*="' + BOOKING_HOST + '"]')) { fireEvents(); return; }
          if (ev.target.closest('a[href^="tel:"]')) { fireCallEvents(); return; }
        }, true);

        // decorate() bounded futtatása — NINCS perzisztens MutationObserver, ami
        // minden DOM-mutációnál teljes querySelectorAll-t (forced reflow) hajtana
        // végre a szigetek hidratálása közben. A statikus linkeket azonnal, a
        // szigetekbe renderelteket pedig a hidratálás lecsengése után dekoráljuk.
        decorate();
        document.addEventListener('DOMContentLoaded', decorate);
        window.addEventListener('load', decorate);
        if (window.requestIdleCallback) window.requestIdleCallback(decorate, { timeout: 2500 });
        else window.setTimeout(decorate, 1800);
      })();
    </script>

    <style is:global>
      /* Metric-matched fallback for Fraunces (computed from Georgia via capsize):
         the headline is laid out in this fallback at the exact same box size, so
         when the real Fraunces swaps in there is no reflow → no CLS. This lets us
         drop the render-competing font preloads and give the LCP image full
         bandwidth on mobile. */
      @font-face {
        font-family: 'Fraunces Fallback';
        src: local('Georgia'), local('Times New Roman');
        size-adjust: 116.2%;
        ascent-override: 84.17%;
        descent-override: 21.95%;
        line-gap-override: 0%;
      }
      /* Metrika-illesztett tartalék a Geist body fonthoz (Arial-ra kalibrálva,
         @capsizecss/unpack-kal számolva). A doboz mérete azonos a Geist-tel, így
         a font-swap NEM okoz reflow-t / CLS-t — fontos, mert a hero LCP bekezdés
         a body fontot használja és azonnal (opacity 1) festődik. */
      @font-face {
        font-family: 'Geist Fallback';
        src: local('Arial');
        size-adjust: 105.8%;
        ascent-override: 94.99%;
        descent-override: 27.88%;
        line-gap-override: 0%;
      }
      @font-face {
        font-family: 'Fraunces';
        font-style: normal;
        font-weight: 100 900;
        font-display: optional;
        src: url('/fonts/fraunces-latin-ext-normal.woff2') format('woff2');
        unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;
      }
      @font-face {
        font-family: 'Fraunces';
        font-style: normal;
        font-weight: 100 900;
        font-display: optional;
        src: url('/fonts/fraunces-latin-normal.woff2') format('woff2');
        unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
      }
      /* Fraunces italic @font-face SZÁNDÉKOSAN eltávolítva: a két italic fájl
         ~152 KiB volt, VeryHigh prioritással töltött a kritikus ablakban, csak a
         display headingek <em> kiemeléséhez (pl. a hero "bőrrel" szó). Helyette a
         böngésző szintetikus dőltet rajzol a már betöltött normal Fraunces-ből
         (font-synthesis: style, alapból engedélyezett) — a kinézet gyakorlatilag
         azonos, de 152 KiB-tal kevesebb tölt a mobil kritikus útban. */
      @font-face {
        font-family: 'Geist';
        font-style: normal;
        font-weight: 400;
        font-display: optional;
        src: url('/fonts/geist-400.woff2') format('woff2');
        unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
      }
      @font-face {
        font-family: 'Geist';
        font-style: normal;
        font-weight: 500;
        font-display: optional;
        src: url('/fonts/geist-500.woff2') format('woff2');
        unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
      }
      @font-face {
        font-family: 'Geist';
        font-style: normal;
        font-weight: 600;
        font-display: optional;
        src: url('/fonts/geist-600.woff2') format('woff2');
        unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
      }

      /* Geist latin-ext subset — a hosszú magyar ékezetes betűk (ő U+0151, ű U+0171,
         Ő U+0150, Ű U+0170) a Latin Extended-A blokkban vannak, amit a fenti latin
         subset NEM fed le. Enélkül a Geist-ből hiányzik az ő/ű glyph, ezért a böngésző
         a 'Geist Fallback' (Arial) betűre esik vissza CSAK ezeknél a karaktereknél →
         látható, eltérő betűkép a szövegben.
         FONTOS: itt 'swap' (NEM 'optional') a font-display, mert a latin-ext külön,
         apró (~8 KB) fájl — 'optional'-lel gyakran nem ér be a ~100 ms-os ablakba, így
         az ő/ű a tartalék Arialon maradt. A 'swap'-pel a Geist ő/ű minden betöltésnél
         megjelenik, amint a fájl megérkezik. CLS-kockázat elhanyagolható: csak néhány
         glyph vált, a 'Geist Fallback' pedig metrika-illesztett (size-adjust), így a
         szélesség gyakorlatilag azonos. A unicode-range miatt csak akkor tölt, ha
         tényleg van ilyen karakter a szövegben. */
      @font-face {
        font-family: 'Geist';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/geist-latin-ext-400.woff2') format('woff2');
        unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;
      }
      @font-face {
        font-family: 'Geist';
        font-style: normal;
        font-weight: 500;
        font-display: swap;
        src: url('/fonts/geist-latin-ext-500.woff2') format('woff2');
        unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;
      }
      @font-face {
        font-family: 'Geist';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/geist-latin-ext-600.woff2') format('woff2');
        unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;
      }

      :root {
        --ease-out-strong:    cubic-bezier(0.23, 1, 0.32, 1);
        --ease-in-out-strong: cubic-bezier(0.77, 0, 0.175, 1);
        --ease-drawer:        cubic-bezier(0.32, 0.72, 0, 1);
      }

      /* A hosszú landing oldalon a böngésző alapból az ÖSSZES szekciót
         layoutolja az első festés előtt (~900ms Style & Layout mobilon, ami a
         szimulált FCP/LCP-t felhúzza). A content-visibility:auto kihagyja a
         képernyőn kívüli szekciók render/layout költségét, amíg a felhasználó
         oda nem görget. A contain-intrinsic-size (auto + becsült magasság)
         fenntartja a görgetősáv arányát, így nincs elcsúszás. A hero (első
         section) mindig azonnal renderel. */
      main > section:not(:first-of-type) {
        content-visibility: auto;
        contain-intrinsic-size: auto 700px;
      }

      .font-display {
        font-feature-settings: 'ss01', 'ss02';
        font-variation-settings: 'SOFT' 30, 'opsz' 144;
      }

      .font-display em, em.display {
        font-style: italic;
        font-variation-settings: 'SOFT' 50, 'opsz' 144;
        color: var(--gold, #B8884A);
      }

      body {
        font-size: 16px;
        line-height: 1.65;
        font-feature-settings: 'kern', 'liga', 'calt';
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      @media (min-width: 768px) { body { font-size: 17px; } }
      p { line-height: 1.7; }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 100px;
        background: #1A1410;
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }

      :where(a, button):focus-visible {
        outline: 2px solid rgba(184, 136, 74, 0.55);
        outline-offset: 3px;
        border-radius: 6px;
      }

      /* A hero-reveal CSAK transform-ot animál (opacity végig 1), így a Chrome az
         LCP-t a legelső festéskor regisztrálja — nincs opacity-fade okozta LCP
         késleltetés. A font-swap CLS-t a font-display:optional + a metrika-
         illesztett tartalék fontok (Fraunces/Geist Fallback) szüntetik meg:
         ha a webfont nem ér be ~100ms alatt, a tartalék marad a látogatásra
         (nincs swap → nincs reflow), a font cache-elve a következő látogatásra. */
      @keyframes heroFadeUp {
        from { transform: translateY(12px); }
        to   { transform: translateY(0); }
      }
      .hero-reveal {
        animation: heroFadeUp 0.6s cubic-bezier(0.23, 1, 0.32, 1) both;
      }
      @media (prefers-reduced-motion: reduce) {
        .hero-reveal { animation: none; opacity: 1; }
      }

      @keyframes zeroJsFade {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      .zero-js-fade {
        animation: zeroJsFade 0.5s cubic-bezier(0.23, 1, 0.32, 1) 0.15s both;
      }
      @media (prefers-reduced-motion: reduce) {
        .zero-js-fade { animation: none; opacity: 1; }
      }
    </style>
  </body>
</html>

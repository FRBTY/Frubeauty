      :root {
        --ease-out-strong:    cubic-bezier(0.23, 1, 0.32, 1);
        --ease-in-out-strong: cubic-bezier(0.77, 0, 0.175, 1);
        --ease-drawer:        cubic-bezier(0.32, 0.72, 0, 1);
        /* A fix fejléc magassága (AnnouncementBar + NavBar). A hero padding-ja
           ebből számol, így a fejléc alatti optikai rés akkor is ugyanaz marad,
           ha a bejelentő sáv megjelenik vagy eltűnik. A default a sáv nélküli
           NavBar magassága (h-16), hogy JS nélkül is helyes legyen. */
        --header-h: 4rem;
        /* Az AnnouncementBar egysoros magassága (py-2.5 + 13px/leading-snug),
           mérve: 54 px. Ha a sáv paddingje változik, EZT is állítsd. */
        --announcement-h: 3.375rem;
      }
      :root[data-announcement='on'] {
        --header-h: calc(4rem + var(--announcement-h));
      }

      /* A hosszú landing oldalon a böngésző alapból az ÖSSZES szekciót
         layoutolja az első festés előtt (~900ms Style & Layout mobilon, ami a
         szimulált FCP/LCP-t felhúzza). A content-visibility:auto kihagyja a
         képernyőn kívüli szekciók render/layout költségét, amíg a felhasználó
         oda nem görget. A contain-intrinsic-size (auto + becsült magasság)
         fenntartja a görgetősáv arányát, így nincs elcsúszás. A hero (első
         section) mindig azonnal renderel. */
      main > section:not(:first-of-type) {
        content-visibility: auto;
        contain-intrinsic-size: auto 700px;
      }

      /* A subsetelt Fraunces fvar táblájában CSAK két tengely van:
         opsz 9–144 (default 9) és wght 100–900. SOFT és WONK NINCS benne, tehát
         a korábbi 'SOFT' 30 / 'SOFT' 50 néma no-op volt — a címsor és a benne lévő
         arany <em> között szánt "lágyság"-különbség sosem renderelődött.

         Az opsz fix 144-re kötése viszont valódi hiba volt: az a ~144 px-es
         plakátméret rajza, kis fokozaton hajszálvékony és össze van húzva.
         Mérve (Fraunces 500, „Szemöldök laminálás"): 20 px-en 165,0 px az opsz 144
         szóhossza a helyes 201,4 px helyett → 22%-kal keskenyebb betűkép a
         navigációs logón, a szolgáltatás-H3-akon és az áraknál.

         Megoldás: a display MÉRETŰ címsorok (h1/h2, 30–72 px) megtartják a 144-et
         — erre van kalibrálva a metrika-illesztett 'Fraunces Fallback' is, így az
         LCP-elem swap-CLS-e nem változik —, minden más display szöveg optikai
         mérete a tényleges betűmérethez igazodik (font-optical-sizing: auto).
         FONTOS: az opsz default 9, ezért az 'auto' kiírása nem elhagyható. */
      .font-display {
        font-feature-settings: 'ss01', 'ss02';
        font-optical-sizing: auto;
      }

      /* A display regiszterhez a rá kalibrált tartalék tartozik (lásd a
         @font-face blokkot fent) — enélkül a h1/h2 a text-tartalékon renderelne,
         ami itt 45%-kal szélesebb lenne a valódi Fraunces-nél. */
      h1.font-display, h2.font-display {
        font-variation-settings: 'opsz' 144;
        font-family: 'Fraunces', 'Fraunces Display Fallback', ui-serif, Georgia, serif;
      }

      /* A font-variation-settings öröklődik, ezért az <em> a szülő címsor optikai
         méretét kapja meg — nem írjuk felül, különben a kis H3-akban lévő em
         visszaesne a 144-es rajzra. */
      .font-display em, em.display {
        font-style: italic;
        color: var(--gold, #B8884A);
      }

      /* A hero címsorában lévő arany <em> a lámpa fénykúpja ELŐTT áll, nem sima
         ink háttéren: ott a #B8884A csak ~3,2:1-et adott (a többi címsoron 6,2:1).
         Ezért a hero kiemelése a világosabb goldGlow tónust kapja → 5,7:1, úgy,
         hogy a hue és a "meleg arany" karakter változatlan.

         A letter-spacing visszaállítása normálra szintén szándékos: a h1 örökölt
         -0,022em-je egy dőlt, talpas betűn a szomszédos szavakba tolta a szót
         ("Kozmetikus|Zuglóban|—"), a záró inline padding pedig a dőlés miatti
         jobb oldali túllógásnak ad helyet. */
      .lamp-root h1 em.display {
        color: #D9B27D;
        letter-spacing: normal;
        padding-inline-end: 0.06em;
      }

      /* Sortörés. A display címsorok eddig „mohó" tördelést kaptak, ezért az
         utolsó soron egyetlen szó maradhatott árván (a hero-ban a „tekintettel."),
         ami optikailag elcsúszott, aszimmetrikus tömböt ad. A balance a sorokat
         egyenlő hosszúságúra osztja; bekezdéseknél a pretty csak a fattyú-szót
         előzi meg, sortörés-költség nélkül. */
      h1, h2, h3 { text-wrap: balance; }
      p, li { text-wrap: pretty; }

      body {
        font-size: 16px;
        line-height: 1.65;
        font-feature-settings: 'kern', 'liga', 'calt';
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      @media (min-width: 768px) { body { font-size: 17px; } }
      p { line-height: 1.7; }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 100px;
        background: #1A1410;
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }

      :where(a, button):focus-visible {
        outline: 2px solid rgba(184, 136, 74, 0.55);
        outline-offset: 3px;
        border-radius: 6px;
      }

      /* A hero-reveal CSAK transform-ot animál (opacity végig 1), így a Chrome az
         LCP-t a legelső festéskor regisztrálja — nincs opacity-fade okozta LCP
         késleltetés. A font-swap CLS-t a font-display:optional + a metrika-
         illesztett tartalék fontok (Fraunces/Geist Fallback) szüntetik meg:
         ha a webfont nem ér be ~100ms alatt, a tartalék marad a látogatásra
         (nincs swap → nincs reflow), a font cache-elve a következő látogatásra. */
      @keyframes heroFadeUp {
        from { transform: translateY(12px); }
        to   { transform: translateY(0); }
      }
      .hero-reveal {
        animation: heroFadeUp 0.6s cubic-bezier(0.23, 1, 0.32, 1) both;
      }
      @media (prefers-reduced-motion: reduce) {
        .hero-reveal { animation: none; opacity: 1; }
      }

      @keyframes zeroJsFade {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      .zero-js-fade {
        animation: zeroJsFade 0.5s cubic-bezier(0.23, 1, 0.32, 1) 0.15s both;
      }
      @media (prefers-reduced-motion: reduce) {
        .zero-js-fade { animation: none; opacity: 1; }
      }
    </style>

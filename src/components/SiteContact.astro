---
/**
 * Reusable contact / booking section. Drop-in for any subpage that needs a
 * conversion block + nyitvatartás + cím. Kept identical across pages so the
 * vendég always finds the same data in the same place — predictable beats clever.
 */
import { MagneticCTA } from './MagneticCTA';
import { Reveal } from './Reveal';
import { siteConfig, openingHours } from '../config/site';

interface Props {
  /** Headline above the booking CTA. Use the *display* em-tag for the italic accent. */
  heading?: string;
  /** Eyebrow caption above the headline. */
  eyebrow?: string;
  /** Optional supporting paragraph after the headline. */
  intro?: string;
}

const {
  heading = 'Találkozzunk az <em class="display">Egressy</em> úton.',
  eyebrow = 'Foglalás',
  intro = 'Online foglalási rendszer 0–24 órában, válasz munkanapokon pár órán belül.',
} = Astro.props;
const config = { ...siteConfig };
---

<section id="kapcsolat" class="py-20 sm:py-28 bg-inkDeep">
  <div class="max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16">
      <Reveal client:visible as="div" className="lg:col-span-6">
        <p class="text-[11px] uppercase tracking-caps text-gold mb-5">{eyebrow}</p>
        <h2
          class="font-display font-light leading-[1.05] tracking-tight text-cream"
          style="font-size: clamp(2rem, 4.5vw, 3.5rem);"
          set:html={heading}
        />
        <p class="mt-6 text-creamSoft text-base sm:text-lg max-w-[50ch] leading-[1.7]">
          {intro}
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <MagneticCTA href={config.booking} external variant="on-dark-primary">
            Időpontot foglalok
          </MagneticCTA>
          <a
            href={`tel:${config.phone}`}
            class="inline-flex items-center justify-center px-6 py-3.5 text-[12px] uppercase tracking-caps font-medium bg-cream text-ink rounded-full hover:bg-goldSoft active:scale-[0.97] active:translate-y-px transition-colors duration-150 gap-2"
            aria-label={`Hívj most! ${config.phoneDisplay}`}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden>
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.33 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
            </svg>
            HÍVJ MOST!
          </a>
        </div>
      </Reveal>

      <Reveal client:visible as="div" className="lg:col-span-6 grid sm:grid-cols-2 gap-6 lg:gap-8" delay={0.1}>
        <div class="border-t border-whisper pt-6">
          <p class="text-[11px] uppercase tracking-caps text-creamMute mb-3">Cím</p>
          <p class="text-lg leading-snug text-cream">{config.address}</p>
          <a
            href={config.mapsUrl}
            target="_blank"
            rel="noopener"
            class="mt-3 inline-flex items-center px-4 py-2 text-[11px] uppercase tracking-caps font-medium bg-gold text-ink rounded-full hover:bg-goldSoft active:scale-[0.97] active:translate-y-px transition-colors duration-150 gap-2"
            aria-label="Útvonaltervezés a Google Mapsen"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden>
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            Útvonaltervezés <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="border-t border-whisper pt-6">
          <p class="text-[11px] uppercase tracking-caps text-creamMute mb-3">Email</p>
          <a
            href={`mailto:${config.email}`}
            class="text-lg leading-snug text-cream hover:text-gold transition-colors break-all"
          >
            {config.email}
          </a>
          <a
            href={`mailto:${config.email}?subject=${encodeURIComponent('Érdeklődés a FRUBEAUTY oldalról')}`}
            class="mt-3 inline-flex items-center px-4 py-2 text-[11px] uppercase tracking-caps font-medium bg-gold text-ink rounded-full hover:bg-goldSoft active:scale-[0.97] active:translate-y-px transition-colors duration-150"
          >
            Írj nekem emailt →
          </a>
        </div>

        <div class="border-t border-whisper pt-6 sm:col-span-2">
          <p class="text-[11px] uppercase tracking-caps text-creamMute mb-4">Nyitvatartás</p>
          <dl class="grid grid-cols-2 gap-y-2 gap-x-6 text-[15px] text-creamSoft">
            {openingHours.map((d) => (
              <>
                <dt class="text-creamMute">{d.day}</dt>
                <dd class="text-right text-cream">{d.hours}</dd>
              </>
            ))}
          </dl>
        </div>

        <div class="border-t border-whisper pt-6 sm:col-span-2">
          <p class="text-[11px] uppercase tracking-caps text-creamMute mb-4">Kövess be Instán és Facebookon.</p>
          <div class="flex items-center gap-3">
            <a
              href={config.instagram}
              target="_blank"
              rel="noopener"
              aria-label="Frubeauty Instagram profil"
              class="inline-flex w-11 h-11 items-center justify-center rounded-full border border-whisperStrong text-cream hover:text-gold hover:border-gold transition-colors duration-200"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden>
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
              </svg>
            </a>
            <a
              href={config.facebook}
              target="_blank"
              rel="noopener"
              aria-label="Frubeauty Facebook oldal"
              class="inline-flex w-11 h-11 items-center justify-center rounded-full border border-whisperStrong text-cream hover:text-gold hover:border-gold transition-colors duration-200"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden>
                <path d="M22 12.07C22 6.51 17.52 2 12 2S2 6.51 2 12.07c0 5.02 3.66 9.18 8.44 9.93v-7.02H7.9v-2.91h2.54V9.83c0-2.52 1.49-3.91 3.78-3.91 1.09 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.77l-.44 2.91h-2.33V22c4.78-.75 8.43-4.91 8.43-9.93Z"/>
              </svg>
            </a>
          </div>
        </div>
      </Reveal>
    </div>
  </div>
</section>

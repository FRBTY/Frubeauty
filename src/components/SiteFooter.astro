---
/**
 * Shared footer. Same markup on every page so navigation feels predictable.
 * Adds /blog and the two subpage URLs to the link cluster so vendégek can
 * hop sideways from a content page if they didn't bounce on the CTA.
 */
import { siteConfig } from '../config/site';

const year = new Date().getFullYear();
const config = { ...siteConfig };
---

<footer class="bg-inkDeep text-creamMute border-t border-whisper">
  <div class="max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12 py-12 grid gap-10 lg:gap-16 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <a href="/" class="font-display text-2xl tracking-tight font-medium text-cream">FRUBEAUTY</a>
      <p class="text-sm text-creamMute mt-3 max-w-[42ch] leading-relaxed">
        Janssen arckezelés, szempilla-lift, szemöldök-laminálás és személyre szabott
        smink Zugló szívében — Pecze-Kovács Fruzsina szalonja.
      </p>
      <p class="text-xs mt-4">{config.address}</p>
      <p class="text-xs mt-1">
        <a href={`tel:${config.phone}`} class="hover:text-cream transition-colors">{config.phoneDisplay}</a>
      </p>
    </div>

    <div class="lg:col-span-3">
      <p class="text-[11px] uppercase tracking-caps text-cream mb-4">Szolgáltatások</p>
      <ul class="space-y-2 text-sm">
        <li><a href="/arckezeles-zuglo" class="hover:text-cream transition-colors">Arckezelés Zugló</a></li>
        <li><a href="/sminkes-zuglo" class="hover:text-cream transition-colors">Alkalmi és esküvői smink</a></li>
        <li><a href="/szempilla-lifting-zuglo" class="hover:text-cream transition-colors">Szempilla/Szemöldök</a></li>
      </ul>
    </div>

    <div class="lg:col-span-2">
      <p class="text-[11px] uppercase tracking-caps text-cream mb-4">Tartalom</p>
      <ul class="space-y-2 text-sm">
        <li><a href="/blog" class="hover:text-cream transition-colors">Blog</a></li>
        <li><a href="/#rolam" class="hover:text-cream transition-colors">Rólam</a></li>
        <li><a href="/#velemenyek" class="hover:text-cream transition-colors">Vélemények</a></li>
      </ul>
    </div>

    <div class="lg:col-span-2">
      <p class="text-[11px] uppercase tracking-caps text-cream mb-4">Jog</p>
      <ul class="space-y-2 text-sm">
        <li><a href="/adatvedelem" rel="privacy-policy" class="hover:text-cream transition-colors">Adatvédelem</a></li>
        <li><a href="/aszf" class="hover:text-cream transition-colors">ÁSZF</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-whisper">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12 py-6 flex flex-wrap items-center justify-between gap-4">
      <p class="text-xs">© {year} Pecze-Kovács Fruzsina e.v. · Minden jog fenntartva</p>
      <div class="flex items-center gap-4">
        <a href={config.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="hover:text-cream transition-colors">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden>
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a href={config.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="hover:text-cream transition-colors">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden>
            <path d="M22 12.07C22 6.51 17.52 2 12 2S2 6.51 2 12.07c0 5.02 3.66 9.18 8.44 9.93v-7.02H7.9v-2.91h2.54V9.83c0-2.52 1.49-3.91 3.78-3.91 1.09 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.77l-.44 2.91h-2.33V22c4.78-.75 8.43-4.91 8.43-9.93Z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

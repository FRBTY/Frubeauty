---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteContact from '../components/SiteContact.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { Reveal } from '../components/Reveal';
import { MagneticCTA } from '../components/MagneticCTA';
import { ProcessSteps } from '../components/ProcessSteps';
import { TestimonialsGrid } from '../components/TestimonialsGrid';
import { GalleryGrid } from '../components/GalleryGrid';
import { FAQ } from '../components/FAQ';
import { PriceList } from '../components/PriceList';
import { CookieBanner } from '../components/CookieBanner';
import { HeroMedia } from '../components/HeroMedia';
import { siteConfig } from '../config/site';

const priceCategories = [
  { eyebrow: 'A nagy nap', title: 'Menyasszonyi csomag.', items: [
    { name: 'Menyasszonyi próbasmink', duration: '90–120 perc', description: 'Az esküvő előtt 4–8 héttel. Együtt tervezzük meg a végleges stílust — színek, intenzitás, fixálás.', price: '15 000 Ft' },
    { name: 'Menyasszonyi smink — a nagy napon', duration: '90 perc', description: 'A próbasmink alapján. Bőrelőkészítés, hosszan tartó alapozás, professzionális fixálás.', price: '25 000 Ft', badge: 'Csomagban is elérhető' },
    { name: 'Örömanya smink', duration: '60–75 perc', description: 'Diszkrét, korhoz illő, fotózásra is alkalmas. A menyasszonyi sminkkel azonos napra ütemezve külön egyeztetéssel.', price: '15 000 Ft' },
  ] },
  { eyebrow: 'Alkalmak és fotózás', title: 'Ünnepi, üzleti, kreatív.', items: [
    { name: 'Alkalmi smink', duration: '60–75 perc', description: 'Bálra, ballagásra, születésnapra vagy keresztelőre – a cél egy fotókész és tartós smink, ami egész nap a helyén marad.', price: '15 000 Ft' },
    { name: 'Smink fotózásra', duration: '60 perc', description: 'Kismama-, családi, portré- és branding fotózásokhoz egyaránt ezt a precíz technológiát alkalmazom, hogy a képeken a legelőnyösebb, mégis teljesen természetes önmagad nyújtsd.', price: '17 000 Ft' },
    { name: 'Nappali smink', duration: '45 perc', description: 'Visszafogott, természetes finish. Üzleti megbeszélésre, randira vagy egy „csak úgy” napra — ahol egy fáradt reggel után pár órát szeretnél spórolni magadnak.', price: '13 000 Ft' },
  ] },
  { eyebrow: 'Tanácsadás és kiszállás', title: 'Extra opciók.', items: [
    { name: 'Sminktanácsadás', duration: '120 perc', description: 'Nem új smink, hanem a meglévő rutin újragondolása: a te arcformádra, a te bőrödre. Megmutatom mit, hogyan, miért — és listát adok arról, mit érdemes kicserélni a kozmetikai táskádban.', price: '15 000 Ft' },
    { name: 'Helyszíni kiszállás', duration: 'Egyeztetés alapján', description: 'A kiszállás díja minden esetben egyedileg, a pontos távolság és az indulási időpont függvényében kerül kalkulálásra.', price: 'Egyedi' },
  ] },
];

const packages = [
  { tier: 'Alap', title: 'Alkalmi', titleAccent: 'Smink', subtitle: 'Egy alkalom, egy esemény', priceOld: null as string | null, price: '15 000 Ft', priceMeta: 'egyedi smink · ~60–75 perc', dailyEquivalent: '≈ 12+ óra tartós eredmény', savings: null as string | null, duration: '~ 60–75 perc', features: ['Bőrelőkészítés és hidratálás','Teljes alkalmi smink — szem, ajak, kontúr','Hosszan tartó fixálás','Bőrbarát, professzionális termékek'], highlight: false, ribbon: null as string | null, footnote: null as string | null },
  { tier: 'Ajánlott', title: 'Menyasszonyi', titleAccent: 'Csomag', subtitle: 'Próbasmink + Menyasszonyi smink együtt', priceOld: '40 000 Ft', price: '35 000 Ft', priceMeta: 'próba + esküvő · 2 alkalom', dailyEquivalent: '≈ 12+ óra fixálás · 0 retus', savings: '5 000 Ft megtakarítás', duration: '~ 90–120 + 90 perc', features: ['Menyasszonyi próbasmink, dokumentálva','A nagy napi smink — a próba alapján','Bőrelőkészítés Janssen ápolókkal','Touch-up tippek és termékajánlás'], highlight: true, ribbon: 'Legtöbben ezt választják', footnote: '*Kiszállási díj külön kerül felszámolásra és a helyszínen fizetendő.' },
  { tier: 'Prémium', title: 'Teljes', titleAccent: 'Esküvő', subtitle: 'Menyasszony + örömanya egy napon', priceOld: '55 000 Ft', price: '48 000 Ft', priceMeta: 'menyasszony + örömanya · 1 reggel', dailyEquivalent: '≈ napi 1 600 Ft — egy esküvőre', savings: '7 000 Ft megtakarítás', duration: '~ 90 + 60–75 perc', features: ['Minden, ami a Menyasszonyi Csomagban','Örömanya smink — diszkrét, korhoz illő','Külön egyeztetés a sorrendről','Prioritásos szezonális időpont'], highlight: false, ribbon: null, footnote: '*Kiszállási díj külön kerül felszámolásra és a helyszínen fizetendő.' },
];

const includedPoints = [
  { eyebrow: '01', title: 'Bőrelőkészítés és hidratálás', body: 'Minden smink alapos tisztítással és hidratálással indul. Ha az alap nem stabil, a smink sem tart.' },
  { eyebrow: '02', title: 'Hosszan tartó fixálás', body: 'Professzionális fixálók és technikák — a smink kibírja az ölelést, a könnyet, az evést és a délutáni táncot. Egy esküvőn ez nem extra, hanem alapelvárás.' },
  { eyebrow: '03', title: 'Bőrbarát alapanyagok', body: 'Csak professzionális, bőrgyógyászatilag tesztelt termékek — köztük Janssen ápolók a smink előtt. Érzékeny bőrre is alkalmas.' },
  { eyebrow: '04', title: 'Folyamatos képzés', body: 'A folyamatos fejlődés nálam alapelv. Évente több továbbképzésen veszek részt, hogy a legújabb tartós technikák és a modern trendek éppúgy a kezemben legyenek, mint a tökéletesen kivitelezett klasszikus formák.' },
];

const processSteps = [
  { step: '01', title: 'Foglalás és rövid előzetes egyeztetés', body: 'Foglalj időpontot a Notino felületén, majd küldj át nekem Instagramon vagy e-mailben 1–2 referenciaképet. Ennyi elég ahhoz, hogy teljesen felkészülten várjalak a székben.' },
  { step: '02', title: 'Próbasmink (csak menyasszonyoknak)', body: 'A próbasmink ideális időpontja az esküvő előtt 4–8 héttel van. Itt kísérletezzük ki és véglegesítjük a stílust, az ott készült fotó pedig a nagy napon a közös, tűpontos tervrajzunk lesz. Így az esküvő reggelén már nincs tippelgetés, csak magabiztos kivitelezés.' },
  { step: '03', title: 'A smink napja', body: 'Bőrelőkészítés, alapozás, kontúrozás, szem, ajak, majd a fixálás. A folyamat minden lépését elmondom közben, és mivel együtt dolgozunk, menet közben is teljesen rugalmasan finomítunk ott, ahol szeretnéd. A cél, hogy a tükörbe nézve százszázalékosan elégedett légy.' },
];

const testimonials = [
  { name: 'Gréti Sápi', rating: 5, text: 'Fruzsi a menyasszonyi sminkemet készítette el, maximálisan figyelembe vette amit szerettem volna és pontosan olyan lett a végeredmény, amit elképzeltem.', service: 'Menyasszonyi smink' },
  { name: 'Dóri', rating: 5, text: 'Csodaszép esküvői sminket varázsolt rám Fruzsi, kétszer is. Emellett nagyon kedves, rugalmas is, ajánlom mindenkinek!', service: 'Menyasszonyi smink' },
  { name: 'Vivien Szűcsné Birnbaum', rating: 5, text: 'Kismama fotózásra készített nekem Fruzsi sminket. Szinte ötlet nélkül mentem, és megtalálta a hozzám legjobban illő sminket. Csodaszép sminkem lett, amit mindenki csak dicsért. Ugyanakkor nagyon tartós is volt, egész nap kitartott.', service: 'Smink fotózásra' },
  { name: 'Emese Simon', rating: 5, text: 'Csodaszép sminket kaptam, annyira tudta Fruzsina, hogy mi áll jól, könnyen ment a választás, és jól is éreztem magam benne egész nap egy esküvőn — tartósnak bizonyult.', service: 'Alkalmi smink' },
  { name: 'Klaudia Vörös', rating: 5, text: 'Már többször vettem igénybe Fruzsi szolgáltatásait. Legutóbb egy csodaszép sminket készített a kismama fotózásomra. Maximálisan elégedett vagyok vele. Mindenkinek tiszta szívvel ajánlom!', service: 'Smink fotózásra' },
  { name: 'Orosz-Adamcsek Zsuzsanna', rating: 5, text: 'Szinte azonnal kaptam időpontot, nagyon rugalmas volt Fruzsi. Minden kérésemet figyelembe vette és egy csodás sminket készített nekem. Visszatérek még hozzá a közeljövőben is.', service: 'Alkalmi smink' },
];

const faqs = [
  { q: 'Mikor érdemes próbasminkre menni?', a: 'Az esküvő előtt 4–8 héttel ideális. Elég idő van rá, hogy ha valami nem 100%-os, együtt finomhangoljuk — de még nem olyan közel a nagy nap, hogy stresszelnél miatta.' },
  { q: 'Mit hozzak magammal alkalmi sminkre?', a: 'Egy referenciaképet a ruhádról (és ha tudod, a frizurádról). Próbasminkre érdemes smink nélkül érkezni — ekkor tisztán látjuk, miből indulunk.' },
  { q: 'Mennyi ideig tart egy smink?', a: 'Nappali smink ~45 perc, alkalmi/menyasszonyi 60–90 perc, próbasmink 90–120 perc. Ha menet közben mégis finomítani szeretnél, számolj +15 perccel.' },
  { q: 'Bírja-e a smink a tánc + meleg + könnyek kombinációt?', a: 'Igen — a fixálás erre épül. Egész estés esküvőkön rendszeresen tesztelve, profi fixálókkal és technikákkal. Külön touch-up termékre csak az ajakra van szükség.' },
  { q: 'Érzékeny a bőröm, ez gondot jelent?', a: 'A próbasmink pont azért van, hogy élesben teszteljük, hogyan reagál a bőröd az anyagokra. Így a nagy napon már semmilyen meglepetés nem érhet, csak a tökéletes, tartós végeredmény.' },
  { q: 'Kiszállás a helyszínre megoldható?', a: 'Igen, a díj a távolságtól és az érkezési időtől függ. Írj egy SMS-t a részletekkel, és megadom a pontos összeget 24 órán belül.' },
];

const galleryImages = [
  '/img/budapest-egressy-ut-smink-frubeauty.webp',
  '/img/alkalmi_kep_smink_alkalmi_smink_budapest_egressy_ut.webp',
  '/img/alkalmi-smink-budapest-egressy-ut-zuglo_munka.webp',
  '/img/eskuvoi-smink-budapest-egressy-ut-zuglo-munka.webp',
  '/img/eskuvoi-smink-zuglo-egressy-ut-budapest-munka.webp',
  '/img/eskuvoi-smink-budapest-egressy-ut-zuglo.webp',
  '/img/menyasszonyi-probasmink-zuglo-budapest-egressy-ut.webp',
  '/img/smink-budapest-alkalmi-budapest-egressy-ut.webp',
  '/img/smink-budapest-alkalmi-egressy-ut-zuglo.webp',
];

// SEO: per-kép alt szövegek a galériához
const galleryAlts = [
  'Alkalmi smink Budapest — FRUBEAUTY Egressy út Zugló',
  'Alkalmi smink munka Budapest, Egressy út — FRUBEAUTY',
  'Alkalmi smink Zugló — FRUBEAUTY XIV. kerület, Egressy út',
  'Esküvői smink Budapest Zugló — FRUBEAUTY Egressy út munka',
  'Esküvői smink Zugló, Egressy út — FRUBEAUTY Budapest',
  'Menyasszonyi smink Budapest — FRUBEAUTY Zugló XIV. kerület',
  'Menyasszonyi próbasmink Zugló Budapest — FRUBEAUTY Egressy út',
  'Alkalmi smink Budapest — FRUBEAUTY XIV. kerület kozmetika',
  'Alkalmi smink Zugló, Egressy út — FRUBEAUTY Budapest',
];

const config = { ...siteConfig };
---

<Layout
  title="Esküvői és Alkalmi Smink Zugló – 13.000 Ft-tól | ★5,0 · 40 Vélemény | FRUBEAUTY"
  description="★5,0 · 40+ Google-értékelés · Esküvői, menyasszonyi és alkalmi smink Zuglóban. Próbasmink, tartós fixálás, helyszíni kiszállás. 13.000 Ft-tól → Foglalj most!"
  preloadImage="/media/smink-oldal-video-frubeauty-budapest-zuglo-poster.webp"
>
  <SiteHeader />

  <section class="relative overflow-hidden pt-32 sm:pt-40 pb-16 sm:pb-24">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-end">
        {/* Hero STATIKUS (a főoldal/szempilla mintára): nincs Reveal/framer-motion és
            nincs MagneticCTA a kritikus úton. A HeroMedia poszter SSR-ben azonnal
            látszik; a videó client:visible-re hidratál. LCP-poszter: Layout preloadImage. */}
        <div class="hero-reveal lg:col-span-7">
          <p class="text-[11px] uppercase tracking-caps text-gold mb-6">Smink · 1143 Budapest · XIV. kerület</p>
          <h1 class="font-display font-light text-cream leading-[1.04] tracking-tightest-" style="font-size: clamp(2.25rem, 6vw, 4.5rem);">Esküvői és alkalmi <em class="display">smink</em> Zuglóban — a fontos pillanatokra.</h1>
          <p class="mt-6 text-base sm:text-lg text-creamSoft leading-[1.7] max-w-[58ch]">Menyasszony, örömanya, ballagó, vagy fotózásra készülő – a cél ugyanaz: a smink, ami reggel felkerül, éjfélkor is pontosan ugyanúgy nézzen vissza a tükörből. Olyan professzionális technikával és textúrákkal dolgozom, amelyek észrevétlenül simulnak a bőrödre, miközben ellenállnak a könnyeknek, az öleléseknek és az áttáncolt éjszakának is.</p>
          <div class="mt-8 sm:mt-10 flex flex-wrap items-center gap-3">
            <a href={config.booking} target="_blank" rel="noopener" class="inline-flex items-center justify-center rounded-full px-7 py-3.5 text-[12px] uppercase tracking-caps font-medium bg-gold text-ink hover:bg-goldSoft active:scale-[0.97] active:translate-y-px transition-colors duration-200">Időpontot foglalok</a>
            <a href="#csomagok" class="inline-flex items-center justify-center rounded-full px-7 py-3.5 text-[12px] uppercase tracking-caps font-medium border border-whisperStrong text-cream hover:bg-white/5 active:scale-[0.97] transition-colors duration-200">Árak</a>
          </div>
          <p class="mt-6 text-[12px] uppercase tracking-caps text-creamMute">Helyszíni kiszállás Budapesten és környékén · Egyedi egyeztetés</p>
        </div>
        <div class="lg:col-span-5">
          <HeroMedia client:visible videoSrc="/media/smink-oldal-video-frubeauty-budapest-zuglo.mp4" posterSrc="/media/smink-oldal-video-frubeauty-budapest-zuglo-poster.webp" alt="Menyasszonyi és alkalmi smink — FRUBEAUTY Zugló, Pecze-Kovács Fruzsina" aspect="4 / 5" maxWidthClass="max-w-full" />
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-whisper bg-inkSoft">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12 py-10">
      <Reveal client:visible as="div" className="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-6">
        <div class="flex flex-col items-center md:items-start"><span class="text-2xl font-display font-medium tracking-tight text-gold">★ 5,0</span><span class="text-[11px] uppercase tracking-caps text-creamMute mt-2 text-center md:text-left"><a href={config.googleReviewsUrl} target="_blank" rel="noopener" class="hover:text-cream transition-colors">40+ Google értékelés →</a></span></div>
        <div class="flex flex-col items-center md:items-start"><span class="text-2xl font-display font-medium tracking-tight text-cream">100+ esküvő</span><span class="text-[11px] uppercase tracking-caps text-creamMute mt-2 text-center md:text-left">megélt nagy nap</span></div>
        <div class="flex flex-col items-center md:items-start"><span class="text-2xl font-display font-medium tracking-tight text-cream">12+ óra</span><span class="text-[11px] uppercase tracking-caps text-creamMute mt-2 text-center md:text-left">átlagos viselési idő</span></div>
        <div class="flex flex-col items-center md:items-start"><span class="text-2xl font-display font-medium tracking-tight text-cream">Kiszállás</span><span class="text-[11px] uppercase tracking-caps text-creamMute mt-2 text-center md:text-left">Budapest és környéke</span></div>
      </Reveal>
    </div>
  </section>

  <section class="py-20 sm:py-28">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <Reveal client:visible as="div" className="lg:col-span-5">
          <p class="text-[11px] uppercase tracking-caps text-gold mb-5">A megközelítés</p>
          <h2 class="font-display font-light leading-[1.1] tracking-tight text-cream" style="font-size: clamp(1.875rem, 4vw, 3rem);">Te maradsz <em class="display">te</em>. Csak ragyogóbban.</h2>
        </Reveal>
        <Reveal client:visible as="div" className="lg:col-span-7 space-y-5 text-creamSoft leading-[1.7] text-[16px] sm:text-[17px]" delay={0.1}>
          <p>Az esküvői és alkalmi smink nálam nem maszk. A cél az, hogy a fotókon is a legfrissebb, <span class="text-cream">önazonos önmagad</span> lásd viszont – nem egy idegent.</p>
          <p>Ezért <span class="text-gold font-medium">nem hiszek</span> a túltolt, nehéz sminkekben. Olyan technikával dolgozom, ami észrevétlenül emeli ki az adottságaidat, miközben garantáltan kibírja a könnyeket, az öleléseket és az áttáncolt éjszakát is.</p>
          <p>A nagy nap előtt minden esetben próbasminket javaslok: itt teszteljük le a bőröd reakcióit és a tartósságot, hogy a helyszínen már nulla kompromisszum és teljes biztonság legyen.</p>
          <p>Ha természetes, mégis megbízható sminket szeretnél, várlak szeretettel.</p>
        </Reveal>
      </div>
    </div>
  </section>

  <section id="csomagok" class="py-20 sm:py-28 bg-inkSoft">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12">
      <Reveal client:visible as="div" className="mb-16 sm:mb-20 max-w-2xl">
        <p class="text-[11px] uppercase tracking-caps text-gold mb-5">Csomagok és árak</p>
        <h2 class="font-display font-light leading-[1.1] tracking-tight text-cream" style="font-size: clamp(1.875rem, 4vw, 3rem);">Három <em class="display">irány</em>, nyolc szolgáltatás.</h2>
        <p class="mt-5 text-creamSoft leading-[1.7]">Az árak a teljes szolgáltatást tartalmazzák — bőrelőkészítés, smink, fixálás. Kiszállás külön, egyedi egyeztetés alapján.</p>
      </Reveal>
      <PriceList client:visible categories={priceCategories} />
    </div>
  </section>

  <section class="py-20 sm:py-28">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12">
      <Reveal client:visible as="div" className="mb-14 sm:mb-20 max-w-2xl">
        <p class="text-[11px] uppercase tracking-caps text-gold mb-5">Csomagajánlatok</p>
        <h2 class="font-display font-light leading-[1.1] tracking-tight text-cream" style="font-size: clamp(1.875rem, 4vw, 3rem);">Válaszd azt, ami <em class="display">Neked</em> szól.</h2>
        <p class="mt-5 text-creamSoft leading-[1.7]">A menyasszonyaim 70%-a a Menyasszonyi Csomagot választja — próba + nagy nap együtt, garantált tartóssággal és nulla helyszíni meglepetéssel.</p>
      </Reveal>
      <div class="grid md:grid-cols-3 gap-5 lg:gap-7 items-stretch">
        {packages.map((p, i) => (
          <Reveal client:visible as="div" delay={0.05 * i} className="h-full">
            <article class={`relative h-full flex flex-col rounded-3xl p-7 sm:p-8 transition-all duration-500 ${p.highlight ? 'bg-inkDeep ring-2 ring-gold/50 md:scale-[1.02] md:-translate-y-1 shadow-[0_20px_60px_-20px_rgba(184,136,74,0.35)]' : 'bg-ink border border-whisper hover:border-whisperStrong'}`}>
              {p.ribbon && (<div class="absolute -top-3 left-1/2 -translate-x-1/2 z-10"><span class="inline-block text-[10px] uppercase tracking-caps font-semibold bg-gold text-ink px-4 py-1.5 rounded-full whitespace-nowrap">{p.ribbon}</span></div>)}
              <p class={`text-[11px] uppercase tracking-caps mb-4 ${p.highlight ? 'text-gold' : 'text-creamMute'}`}>{p.tier}</p>
              <h3 class="font-display font-light leading-[1.1] tracking-tight text-cream" style="font-size: clamp(1.5rem, 2.4vw, 1.875rem);">{p.title}{' '}<em class="display">{p.titleAccent}</em></h3>
              <p class="mt-2 text-sm text-creamMute leading-snug max-w-[28ch]">{p.subtitle}</p>
              {p.footnote && (<p class="mt-2 text-[10.5px] italic text-creamMute/80 leading-snug max-w-[30ch]">{p.footnote}</p>)}
              <div class="mt-6">{p.priceOld && (<p class="text-sm text-creamMute mb-1">Külön: <span class="line-through">{p.priceOld}</span></p>)}<p class="font-display text-3xl sm:text-4xl font-medium tracking-tight text-cream">{p.price}</p><p class="text-xs text-creamMute mt-2">{p.priceMeta}</p></div>
              {p.savings && (<div class="mt-4"><span class="inline-flex items-center gap-1.5 text-[11px] uppercase tracking-caps font-medium bg-gold/15 text-gold border border-gold/30 px-3 py-1.5 rounded-full"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden><polyline points="20 6 9 17 4 12" /></svg>{p.savings}</span></div>)}
              <p class="mt-4 text-[12px] italic text-creamSoft/70 leading-snug">{p.dailyEquivalent}</p>

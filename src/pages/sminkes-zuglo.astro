---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteContact from '../components/SiteContact.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { Reveal } from '../components/Reveal';
import { MagneticCTA } from '../components/MagneticCTA';
import { ProcessSteps } from '../components/ProcessSteps';
import { TestimonialsGrid } from '../components/TestimonialsGrid';
import { GalleryGrid } from '../components/GalleryGrid';
import FAQList from '../components/FAQList.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { CookieBanner } from '../components/CookieBanner';
import { HeroMedia } from '../components/HeroMedia';
import { ScrollVideo } from '../components/ScrollVideo';
import { siteConfig, relFor } from '../config/site';
import { videoObjectSchema } from '../config/videos';

const priceCategories = [
  { eyebrow: 'A nagy nap', title: 'Menyasszonyi csomag.', items: [
    { name: 'Menyasszonyi próbasmink', duration: '90–120 perc', description: 'Az esküvő előtt 4–8 héttel. Együtt tervezzük meg a végleges stílust — színek, intenzitás, fixálás.', price: '15 000 Ft' },
    { name: 'Menyasszonyi smink — a nagy napon', duration: '90 perc', description: 'A próbasmink alapján. Bőrelőkészítés, hosszan tartó alapozás, professzionális fixálás.', price: '30 000 Ft', badge: 'Csomagban is elérhető' },
    { name: 'Örömanya smink', duration: '60–75 perc', description: 'Diszkrét, korhoz illő, fotózásra is alkalmas. A menyasszonyi sminkkel azonos napra ütemezve külön egyeztetéssel.', price: '15 000 Ft' },
  ] },
  { eyebrow: 'Alkalmak és fotózás', title: 'Ünnepi, üzleti, kreatív.', items: [
    { name: 'Alkalmi smink', duration: '60–75 perc', description: 'Bálra, ballagásra, születésnapra vagy keresztelőre – a cél egy fotókész és tartós smink, ami egész nap a helyén marad.', price: '15 000 Ft' },
    { name: 'Smink fotózásra', duration: '60 perc', description: 'Kismama-, családi, portré- és branding fotózásokhoz egyaránt ezt a precíz technológiát alkalmazom, hogy a képeken a legelőnyösebb, mégis teljesen természetes önmagad nyújtsd.', price: '17 000 Ft' },
    { name: 'Nappali smink', duration: '45 perc', description: 'Visszafogott, természetes finish. Üzleti megbeszélésre, randira vagy egy „csak úgy” napra — ahol egy fáradt reggel után pár órát szeretnél spórolni magadnak.', price: '13 000 Ft' },
  ] },
  { eyebrow: 'Tanácsadás és kiszállás', title: 'Extra opciók.', items: [
    { name: 'Sminktanácsadás', duration: '120 perc', description: 'Nem új smink, hanem a meglévő rutin újragondolása: a te arcformádra, a te bőrödre. Megmutatom mit, hogyan, miért — és listát adok arról, mit érdemes kicserélni a kozmetikai táskádban.', price: '15 000 Ft' },
    { name: 'Helyszíni kiszállás', duration: 'Egyeztetés alapján', description: 'A kiszállás díja minden esetben egyedileg, a pontos távolság és az indulási időpont függvényében kerül kalkulálásra.', price: 'Egyedi' },
  ] },
];

const packages = [
  { tier: 'Alap', title: 'Alkalmi', titleAccent: 'Smink', subtitle: 'Egy alkalom, egy esemény', priceOld: null as string | null, price: '15 000 Ft', priceMeta: 'egyedi smink · ~60–75 perc', dailyEquivalent: 'bőrelőkészítéssel és fixálással', savings: null as string | null, duration: '~ 60–75 perc', features: ['Bőrelőkészítés és hidratálás','Teljes alkalmi smink — szem, ajak, kontúr','Hosszan tartó fixálás','Professzionális termékek'], highlight: false, ribbon: null as string | null, footnote: null as string | null },
  { tier: 'Ajánlott', title: 'Menyasszonyi', titleAccent: 'Csomag', subtitle: 'Próbasmink + Menyasszonyi smink együtt', priceOld: '45 000 Ft', price: '39 000 Ft', priceMeta: 'próba + esküvő · 2 alkalom', dailyEquivalent: 'két előre egyeztetett alkalom', savings: '6 000 Ft megtakarítás', duration: '~ 90–120 + 90 perc', features: ['Menyasszonyi próbasmink, dokumentálva','A nagy napi smink — a próba alapján','Bőrelőkészítés Janssen ápolókkal','Touch-up tippek és termékajánlás'], highlight: true, ribbon: 'Próba + nagy nap', footnote: '*Kiszállási díj külön kerül felszámolásra és a helyszínen fizetendő.' },
  { tier: 'Prémium', title: 'Teljes', titleAccent: 'Esküvő', subtitle: 'Menyasszony + örömanya egy napon', priceOld: '60 000 Ft', price: '51 000 Ft', priceMeta: 'menyasszony + örömanya · 1 reggel', dailyEquivalent: '≈ napi 1 700 Ft — egy esküvőre', savings: '9 000 Ft megtakarítás', duration: '~ 90 + 60–75 perc', features: ['Minden, ami a Menyasszonyi Csomagban','Örömanya smink — diszkrét, korhoz illő','Külön egyeztetés a sorrendről','Prioritásos szezonális időpont'], highlight: false, ribbon: null, footnote: '*Kiszállási díj külön kerül felszámolásra és a helyszínen fizetendő.' },
];

const includedPoints = [
  { eyebrow: '01', title: 'Bőrelőkészítés és hidratálás', body: 'Minden smink alapos tisztítással és hidratálással indul. Ha az alap nem stabil, a smink sem tart.' },
  { eyebrow: '02', title: 'Hosszan tartó fixálás', body: 'Professzionális fixálók és technikák — a smink kibírja az ölelést, a könnyet, az evést és a délutáni táncot. Egy esküvőn ez nem extra, hanem alapelvárás.' },
  { eyebrow: '03', title: 'Bőrbarát alapanyagok', body: 'Csak professzionális, bőrgyógyászatilag tesztelt termékek — köztük Janssen ápolók a smink előtt. Érzékeny bőrre is alkalmas.' },
  { eyebrow: '04', title: 'Folyamatos képzés', body: 'A folyamatos fejlődés nálam alapelv. Évente több továbbképzésen veszek részt, hogy a legújabb tartós technikák és a modern trendek éppúgy a kezemben legyenek, mint a tökéletesen kivitelezett klasszikus formák.' },
];

const processSteps = [
  { step: '01', title: 'Foglalás, előleg, rövid egyeztetés', body: 'Foglalj időpontot a Notino felületén. A foglalásodat akkor tudom jóváhagyni, ha a 10 000 Ft előleg átutalással megérkezett — az utaláshoz szükséges adatokat a foglalás után küldöm. Ez az előleg rögzíti a dátumot, teljes egészében beleszámít a smink árába, és ha időpontot kell változtatnod, egy éven belül átvihető. Utána küldj át Instagramon vagy e-mailben 1–2 referenciaképet — ennyi elég ahhoz, hogy teljesen felkészülten várjalak.' },
  { step: '02', title: 'Próbasmink (csak menyasszonyoknak)', body: 'A próbasmink ideális időpontja az esküvő előtt 4–8 héttel van. Itt kísérletezzük ki és véglegesítjük a stílust, az ott készült fotó pedig a nagy napon a közös, tűpontos tervrajzunk lesz. Így az esküvő reggelén már nincs tippelgetés, csak magabiztos kivitelezés.' },
  { step: '03', title: 'A smink napja', body: 'Bőrelőkészítés, alapozás, kontúrozás, szem, ajak, majd a fixálás. A folyamat minden lépését elmondom közben, és mivel együtt dolgozunk, menet közben is teljesen rugalmasan finomítunk ott, ahol szeretnéd. A cél, hogy a tükörbe nézve százszázalékosan elégedett légy.' },
];

const testimonials = [
  { name: 'Gréti Sápi', rating: 5, text: 'Fruzsi a menyasszonyi sminkemet készítette el, maximálisan figyelembe vette amit szerettem volna és pontosan olyan lett a végeredmény, amit elképzeltem.', service: 'Menyasszonyi smink' },
  { name: 'Dóri', rating: 5, text: 'Csodaszép esküvői sminket varázsolt rám Fruzsi, kétszer is. Emellett nagyon kedves, rugalmas is, ajánlom mindenkinek!', service: 'Menyasszonyi smink' },
  { name: 'Vivien Szűcsné Birnbaum', rating: 5, text: 'Kismama fotózásra készített nekem Fruzsi sminket. Szinte ötlet nélkül mentem, és megtalálta a hozzám legjobban illő sminket. Csodaszép sminkem lett, amit mindenki csak dicsért. Ugyanakkor nagyon tartós is volt, egész nap kitartott.', service: 'Smink fotózásra' },
  { name: 'Emese Simon', rating: 5, text: 'Csodaszép sminket kaptam, annyira tudta Fruzsina, hogy mi áll jól, könnyen ment a választás, és jól is éreztem magam benne egész nap egy esküvőn — tartósnak bizonyult.', service: 'Alkalmi smink' },
  { name: 'Klaudia Vörös', rating: 5, text: 'Már többször vettem igénybe Fruzsi szolgáltatásait. Legutóbb egy csodaszép sminket készített a kismama fotózásomra. Maximálisan elégedett vagyok vele. Mindenkinek tiszta szívvel ajánlom!', service: 'Smink fotózásra' },
  { name: 'Orosz-Adamcsek Zsuzsanna', rating: 5, text: 'Szinte azonnal kaptam időpontot, nagyon rugalmas volt Fruzsi. Minden kérésemet figyelembe vette és egy csodás sminket készített nekem. Visszatérek még hozzá a közeljövőben is.', service: 'Alkalmi smink' },
];

const faqs = [
  { q: 'Mikor érdemes próbasminkre menni?', a: 'Az esküvő előtt 4–8 héttel ideális. Elég idő van rá, hogy ha valami nem 100%-os, együtt finomhangoljuk — de még nem olyan közel a nagy nap, hogy stresszelnél miatta.' },
  { q: 'Mit hozzak magammal alkalmi sminkre?', a: 'Egy referenciaképet a ruhádról (és ha tudod, a frizurádról). Próbasminkre érdemes smink nélkül érkezni — ekkor tisztán látjuk, miből indulunk.' },
  { q: 'Mennyi ideig tart egy smink?', a: 'Nappali smink ~45 perc, alkalmi/menyasszonyi 60–90 perc, próbasmink 90–120 perc. Ha menet közben mégis finomítani szeretnél, számolj +15 perccel.' },
  { q: 'Bírja-e a smink a tánc + meleg + könnyek kombinációt?', a: 'Igen — a fixálás erre épül. Egész estés esküvőkön rendszeresen tesztelve, profi fixálókkal és technikákkal. Külön touch-up termékre csak az ajakra van szükség.' },
  { q: 'Érzékeny a bőröm, ez gondot jelent?', a: 'A próbasmink pont azért van, hogy élesben teszteljük, hogyan reagál a bőröd az anyagokra. Így a nagy napon már semmilyen meglepetés nem érhet, csak a tökéletes, tartós végeredmény.' },
  { q: 'Kiszállás a helyszínre megoldható?', a: 'Igen, a díj a távolságtól és az érkezési időtől függ. Írj egy SMS-t a részletekkel, és megadom a pontos összeget 24 órán belül.' },
  { q: 'Kell előleget fizetni a foglaláshoz?', a: 'Igen, 10 000 Ft-ot. A Notino rendszerében leadott foglalásodat akkor tudom jóváhagyni, ha ez az összeg átutalással megérkezett — az utaláshoz szükséges adatokat a foglalás után küldöm el. Fontos: az előleg nem plusz költség, teljes egészében beleszámít a smink árába. Ez az, ami ténylegesen rögzíti a dátumot: amíg nem érkezik meg, az időpont szabad marad, és a szezonban a szombat reggeleket gyorsan elviszik.' },
  { q: 'Mi történik az előleggel, ha az esküvő elmarad vagy csúszik?', a: 'Nem vész el. Ha az esküvő elmarad, vagy időpontot kell változtatnod, az előleg az eredeti időponttól számított egy éven belül bármely másik szabad időpontra átvihető — próbasminkre és a nagy napra egyaránt. Csak szólj időben, és megkeressük az új dátumot.' },
];

const galleryImages = [
  '/img/alkalmi-smink-elotte-utana-zuglo-egressy-ut-budapest.webp',
  '/img/alkalmi-smink-vendeg-zuglo-egressy-ut-budapest.webp',
  '/img/nappali-smink-termeszetes-zuglo-egressy-ut-budapest.webp',
  '/img/budapest-egressy-ut-smink-frubeauty.webp',
  '/img/alkalmi_kep_smink_alkalmi_smink_budapest_egressy_ut.webp',
  '/img/alkalmi-smink-budapest-egressy-ut-zuglo_munka.webp',
  '/img/eskuvoi-smink-budapest-egressy-ut-zuglo-munka.webp',
  '/img/eskuvoi-smink-zuglo-egressy-ut-budapest-munka.webp',
  '/img/eskuvoi-smink-budapest-egressy-ut-zuglo.webp',
  '/img/menyasszonyi-probasmink-zuglo-budapest-egressy-ut.webp',
  '/img/smink-budapest-alkalmi-budapest-egressy-ut.webp',
  '/img/smink-budapest-alkalmi-egressy-ut-zuglo.webp',
];

// SEO: per-kép alt szövegek a galériához
const galleryAlts = [
  'Alkalmi smink előtte-utána — természetes hatású smink, FRUBEAUTY Zugló, Egressy út',
  'Alkalmi smink vendégen — hangsúlyos szemsmink, FRUBEAUTY Budapest, Egressy út',
  'Természetes nappali smink — tartós alapozás, FRUBEAUTY Zugló XIV. kerület',
  'Alkalmi smink Budapest — FRUBEAUTY Egressy út Zugló',
  'Alkalmi smink munka Budapest, Egressy út — FRUBEAUTY',
  'Alkalmi smink Zugló — FRUBEAUTY XIV. kerület, Egressy út',
  'Esküvői smink Budapest Zugló — FRUBEAUTY Egressy út munka',
  'Esküvői smink Zugló, Egressy út — FRUBEAUTY Budapest',
  'Menyasszonyi smink Budapest — FRUBEAUTY Zugló XIV. kerület',
  'Menyasszonyi próbasmink Zugló Budapest — FRUBEAUTY Egressy út',
  'Alkalmi smink Budapest — FRUBEAUTY XIV. kerület kozmetika',
  'Alkalmi smink Zugló, Egressy út — FRUBEAUTY Budapest',
];

// ── SEO: FAQPage schema (featured snippet esélyes kérdésekre) ─────────────
const sminkFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};

// ── SEO: tételes ár-ajánlatok az ár-táblázathoz (a schema = a látható tartalom) ──
const pricedOffers = priceCategories
  .flatMap((cat) => cat.items)
  .filter((it) => /\d/.test(it.price))
  .map((it) => ({
    '@type': 'Offer',
    name: it.name,
    price: it.price.replace(/[^\d]/g, ''),
    priceCurrency: 'HUF',
    availability: 'https://schema.org/InStock',
  }));

// ── SEO: Service schema az alkalmi/esküvői sminkhez ───────────────────────
const sminkServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Esküvői és alkalmi smink Zugló',
  description:
    'Menyasszonyi, alkalmi és fotózásra készülő smink Zuglóban, XIV. kerületben. Próbasmink, tartós fixálás, helyszíni kiszállás Budapesten és környékén.',
  provider: {
    '@type': 'BeautySalon',
    '@id': 'https://frubeauty.com/#business',
    name: 'FRUBEAUTY – Pecze-Kovács Fruzsina Kozmetikus',
    url: 'https://frubeauty.com',
  },
  areaServed: [
    { '@type': 'City', name: 'Budapest' },
    { '@type': 'AdministrativeArea', name: 'Zugló' },
  ],
  offers: {
    '@type': 'AggregateOffer',
    lowPrice: '13000',
    highPrice: '51000',
    priceCurrency: 'HUF',
    availability: 'https://schema.org/InStock',
    priceValidUntil: '2026-12-31',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Esküvői, menyasszonyi és alkalmi smink árak — Zugló',
    itemListElement: pricedOffers,
  },
};

// ── SEO: VideoObject schemák a két menyasszonyi referencia-videóhoz ───────
// A mezők a központi videó-katalógusból jönnek (src/config/videos.ts), így a
// JSON-LD és a /video-sitemap.xml nem tud szétcsúszni.
const sminkVideoSchemas = [
  videoObjectSchema('menyasszonyi-smink-kesz-look'),
  videoObjectSchema('eskuvoi-smink-menyasszonyi-look'),
];

// ── SEO: BreadcrumbList schema ────────────────────────────────────────────
const sminkBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Főoldal', item: 'https://frubeauty.com' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Esküvői és alkalmi smink Zugló',
      item: 'https://frubeauty.com/sminkes-zuglo/',
    },
  ],
};

const config = { ...siteConfig };

// 2026-08-21 Ahrefs-audit — a title NE menjen vissza "Sminkes Budapest…"-re:
// a Google felülírta azt, és a SERP-ben a régi, ár-vezetett változatot írta ki
// ("Esküvői smink árak Budapest 2026 – 25.000 Ft"), vagyis az illeszkedett jobban
// a lekérdezéshez. Az oldal az "esküvői smink árak"-ra áll #5-ön (90/hó), ezért a
// kulcsszó visszakerült a címbe. Az ár a 08-15-i emelés utáni 30.000 Ft — a Google
// által kiírt 25.000 elavult. A "Sminkes Budapest" a H1-ben és a leírásban él tovább.
---

<Layout
  title="Esküvői smink árak Budapest 2026 – 30.000 Ft | FRUBEAUTY"
  description="Esküvői smink árak Budapesten 2026: menyasszonyi smink 30.000 Ft, próbasminkkel csomagban 39.000 Ft, alkalmi smink 15.000 Ft — rejtett díj nélkül."
  additionalSchemas={[sminkFaqSchema, sminkServiceSchema, ...sminkVideoSchemas, sminkBreadcrumbSchema]}
  preloadImage="/media/smink-oldal-video-frubeauty-budapest-zuglo-poster.avif"
>
  <SiteHeader />

  <section class="relative overflow-hidden pt-[calc(var(--header-h)+4rem)] sm:pt-[calc(var(--header-h)+6rem)] pb-16 sm:pb-24">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-end">
        {/* Hero STATIKUS (a főoldal/szempilla mintára): nincs Reveal/framer-motion és
            nincs MagneticCTA a kritikus úton. A HeroMedia poszter SSR-ben azonnal
            látszik; a videó client:visible-re hidratál. LCP-poszter: Layout preloadImage. */}
        <div class="hero-reveal lg:col-span-7">
          <p class="text-[11px] uppercase tracking-caps text-gold mb-6">Smink · 1143 Budapest · XIV. kerület</p>
          <h1 class="font-display font-light text-cream leading-[1.04] tracking-tightest-" style="font-size: clamp(2.25rem, 6vw, 4.5rem);">Esküvői és alkalmi <em class="display">smink</em> Budapesten.</h1>
          <p class="mt-6 text-base sm:text-lg text-creamSoft leading-[1.7] max-w-[58ch]">Az esküvői smink árak nálam tételesen: menyasszonyi smink <strong class="font-medium text-cream">30.000 Ft</strong>, próbasminkkel csomagban 39.000 Ft, alkalmi smink 15.000 Ft — mindegyik árban benne van a bőrelőkészítés és a hosszan tartó fixálás. Budapesten, a XIV. kerületi Egressy úton dolgozom, esküvői helyszínre kiszállással is.</p>
          <div class="mt-8 sm:mt-10 flex flex-wrap items-center gap-3">
            <a href={config.booking} target="_blank" rel={relFor(config.booking)} class="inline-flex items-center justify-center rounded-full px-7 py-3.5 text-[12px] uppercase tracking-caps font-medium bg-gold text-ink hover:bg-goldSoft active:scale-[0.97] active:translate-y-px transition-colors duration-200">Időpontot foglalok</a>
            <a href="#csomagok" class="inline-flex items-center justify-center rounded-full px-7 py-3.5 text-[12px] uppercase tracking-caps font-medium border border-whisperStrong text-cream hover:bg-white/5 active:scale-[0.97] transition-colors duration-200">Árak</a>
          </div>
          <p class="mt-6 text-[12px] uppercase tracking-caps text-creamMute">Helyszíni kiszállás Budapesten és környékén · Egyedi egyeztetés</p>
        </div>
        <div class="lg:col-span-5">
          <HeroMedia client:visible videoSrc="/media/smink-oldal-video-frubeauty-budapest-zuglo.mp4" posterSrc="/media/smink-oldal-video-frubeauty-budapest-zuglo-poster.webp" alt="Menyasszonyi és alkalmi smink — FRUBEAUTY Zugló, Pecze-Kovács Fruzsina" aspect="4 / 5" maxWidthClass="max-w-full" />
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-whisper bg-inkSoft">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12 py-10">
      <Reveal client:visible as="div" className="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-6">
        <div class="flex flex-col items-center md:items-start"><span class="text-2xl font-display font-medium tracking-tight text-gold">Google</span><span class="text-[11px] uppercase tracking-caps text-creamMute mt-2 text-center md:text-left"><a href={config.googleReviewsUrl} target="_blank" rel="noopener" class="hover:text-cream transition-colors">Értékelések megnyitása →</a></span></div>
        <div class="flex flex-col items-center md:items-start"><span class="text-2xl font-display font-medium tracking-tight text-cream">30 000 Ft</span><span class="text-[11px] uppercase tracking-caps text-creamMute mt-2 text-center md:text-left">menyasszonyi smink</span></div>
        <div class="flex flex-col items-center md:items-start"><span class="text-2xl font-display font-medium tracking-tight text-cream">39 000 Ft</span><span class="text-[11px] uppercase tracking-caps text-creamMute mt-2 text-center md:text-left">próbasminkkel</span></div>
